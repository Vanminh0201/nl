APP_NAME="Quản lý dự án công nghiệp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://congnghiepquangtri.com
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
