<?php

namespace App\Http\Controllers;

use App\Models\BieuTuong;
use App\Models\DoiTuongHaTang;
use App\Models\DuAn;
use App\Models\LoaiHinhDuAn;
use App\Models\LopHaTang;
use App\Models\TrangThaiDuAn;
use App\Services\PhanTichHaTang;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;

class BanDoController extends Controller
{
    public function index()
    {
        return view('ban-do.index', [
            'lop' => LopHaTang::withCount('doiTuong')->orderBy('ten')->get(),
            'dsLoaiHinh' => LoaiHinhDuAn::danhSach(),
            'dsTrangThai' => TrangThaiDuAn::danhSach(),
            'dsBieuTuong' => BieuTuong::danhSach()->values(),
        ]);
    }

    /** GeoJSON các dự án đang khớp bộ lọc, gồm điểm đại diện và mọi lớp đường/vùng/điểm phụ nếu có */
    public function duAn(Request $request): JsonResponse
    {
        $features = DuAn::query()
            ->loc($request->only(['tu_khoa', 'loai_hinh', 'trang_thai', 'dia_diem']))
            ->whereNotNull('vi_do')
            ->with(['hinhHoc' => fn ($q) => $q->where('hien_thi', true)])
            ->get()
            ->flatMap(function (DuAn $d) {
                $tt = [
                    'id' => $d->id,
                    'ten' => $d->ten,
                    'chu_dau_tu' => $d->chu_dau_tu,
                    'loai_hinh' => $d->ten_loai_hinh,
                    'loai_hinh_ma' => $d->loai_hinh,
                    'bieu_tuong' => $d->bieu_tuong_loai_hinh,
                    'mau' => $d->mau,
                    'trang_thai' => $d->trang_thai,
                    'dia_diem' => $d->dia_diem,
                    'von' => $d->von_dang_ky,
                    'url' => route('du-an.show', $d),
                    // Điểm đại diện gửi kèm mọi feature (kể cả dự án chỉ vẽ bằng đường/vùng, không có
                    // chấm điểm riêng) — làm chỗ đặt nhãn tên dự án trên bản đồ.
                    'vi_do' => $d->vi_do,
                    'kinh_do' => $d->kinh_do,
                ];

                $ds = [];

                // Đã có lớp đường/vùng thật thì thôi không chấm thêm điểm đại diện cho rối bản đồ,
                // chỉ khi dự án chỉ có mỗi toạ độ đơn (không đường không vùng) mới cần chấm điểm.
                if (! $d->co_hinh_dang) {
                    $ds[] = [
                        'type' => 'Feature',
                        'properties' => $tt + ['vai_tro' => 'diem'],
                        'geometry' => ['type' => 'Point', 'coordinates' => [$d->kinh_do, $d->vi_do]],
                    ];
                }

                foreach ($d->hinhHoc as $h) {
                    // toa_do lưu [lat, lng], GeoJSON cần [lng, lat]
                    $toa = array_map(fn ($p) => [$p[1], $p[0]], $h->toa_do);
                    $hinhHocGeo = match ($h->loai) {
                        // Nhiều điểm gộp thành 1 lớp (VD cột/mốc dọc tuyến) dùng MultiPoint để
                        // vẫn ẩn/hiện cả nhóm bằng 1 thao tác, thay vì tách hàng trăm lớp riêng.
                        'diem' => count($toa) > 1
                            ? ['type' => 'MultiPoint', 'coordinates' => $toa]
                            : ['type' => 'Point', 'coordinates' => $toa[0]],
                        'duong' => ['type' => 'LineString', 'coordinates' => $toa],
                        'vung' => ['type' => 'Polygon', 'coordinates' => [[...$toa, $toa[0]]]],
                    };

                    $ds[] = [
                        'type' => 'Feature',
                        'properties' => $tt + [
                            'vai_tro' => 'lop',
                            'lop_loai' => $h->loai,
                            'lop_ten' => $h->ten,
                            'lop_bieu_tuong' => $h->bieu_tuong ?? 'diem_moc',
                            'lop_nhan' => $h->nhan_diem,
                        ],
                        'geometry' => $hinhHocGeo,
                    ];
                }

                return $ds;
            })
            ->values();

        return response()->json(['type' => 'FeatureCollection', 'features' => $features]);
    }

    /** GeoJSON hạ tầng lưới điện trong khung nhìn hiện tại */
    public function haTang(Request $request, PhanTichHaTang $phanTich): JsonResponse
    {
        $request->validate(['bbox' => ['required', 'string']]);

        $bbox = array_map('floatval', explode(',', $request->query('bbox')));
        if (count($bbox) !== 4) {
            return response()->json(['message' => 'Tham số bbox phải gồm 4 giá trị.'], 422);
        }

        $gioiHan = (int) config('duan.gioi_han_ha_tang', 4000);
        $features = $phanTich->trongKhungNhin($bbox, $gioiHan);

        return response()->json([
            'type' => 'FeatureCollection',
            'features' => $features,
            'bi_cat' => count($features) >= $gioiHan,
        ]);
    }

    /**
     * Thống kê lớp hạ tầng lưới điện theo cấp điện áp, dùng cho menu "Lưới điện" ở trang Bản đồ:
     * mỗi cấp gồm danh sách tuyến đường dây (gộp cặp điểm/đường cùng tuyến) và danh sách TBA cụ
     * thể theo tên, chia theo Hiện trạng/Quy hoạch để bấm vào là bay tới đúng vị trí trên bản đồ.
     */
    public function thongKeHaTang(): JsonResponse
    {
        $lop = LopHaTang::orderBy('id')->get(['id', 'ten', 'quy_hoach', 'so_doi_tuong', 'hien_thi']);
        $theoTen = $lop->keyBy('ten');
        $hienThiTheoId = $lop->pluck('hien_thi', 'id');
        $daGhep = [];

        $tuyenTheoKv = [];
        $lopTbaTheoKv = [];

        foreach ($lop as $l) {
            if (in_array($l->id, $daGhep, true)) {
                continue;
            }
            if (! preg_match('/^(Đường dây|TBA)\b.*?(\d+)\s*kV/u', $l->ten, $m)) {
                continue;
            }
            $kv = (int) $m[2];
            $trangThai = $l->quy_hoach ? 'quy_hoach' : 'hien_trang';

            if ($m[1] === 'TBA') {
                $lopTbaTheoKv[$kv][$trangThai][] = $l->id;
                $daGhep[] = $l->id;

                continue;
            }

            // Đường dây: ghép cặp lớp "điểm" + "đường" cùng tuyến lại thành 1 dòng hiển thị. Dò theo
            // tên gốc (bỏ hậu tố) rồi tìm CẢ HAI vế thay vì chỉ tìm xuôi từ "điểm" sang "đường" —
            // vì lớp "đường" thường có id nhỏ hơn nên được duyệt trước, tìm ngược mới không bị trùng.
            $goc = preg_replace('/\s*—\s*(điểm|đường)$/u', '', $l->ten);
            $lopId = [];
            $soDoiTuong = 0;
            if ($goc !== $l->ten) {
                foreach (['điểm', 'đường'] as $hauTo) {
                    $cap = $theoTen->get($goc.' — '.$hauTo);
                    if ($cap) {
                        $lopId[] = $cap->id;
                        $soDoiTuong += $cap->so_doi_tuong;
                    }
                }
            } else {
                $lopId[] = $l->id;
                $soDoiTuong = $l->so_doi_tuong;
            }
            foreach ($lopId as $id) {
                $daGhep[] = $id;
            }

            $tuyenTheoKv[$kv][$trangThai][] = [
                'ten' => $this->tenTuyenHaTang($l->ten),
                'lop_id' => $lopId,
                'so_doi_tuong' => $soDoiTuong,
                // Coi cả tuyến là "đang hiện" chỉ khi mọi lớp thuộc tuyến (điểm + đường) đều hiện —
                // nút con mắt ở menu Lưới điện bật/tắt đồng thời cả cặp để không bị lệch nhau.
                'hien_thi' => collect($lopId)->every(fn ($id) => (bool) ($hienThiTheoId[$id] ?? true)),
            ];
        }

        // Khung toạ độ từng tuyến đường dây, để bấm vào là bay (fitBounds) tới đúng khu vực
        foreach ($tuyenTheoKv as $kv => $theoTrangThai) {
            foreach ($theoTrangThai as $tt => $dsTuyen) {
                foreach ($dsTuyen as $i => $tuyen) {
                    $bbox = DoiTuongHaTang::whereIn('lop_id', $tuyen['lop_id'])
                        ->selectRaw('MIN(min_vi_do) nam, MAX(max_vi_do) bac, MIN(min_kinh_do) tay, MAX(max_kinh_do) dong')
                        ->first();
                    if ($bbox && $bbox->nam !== null) {
                        $tuyenTheoKv[$kv][$tt][$i]['gioi_han'] = [
                            [(float) $bbox->nam, (float) $bbox->tay],
                            [(float) $bbox->bac, (float) $bbox->dong],
                        ];
                    }
                }
            }
        }

        // Danh sách TBA cụ thể theo tên, kèm toạ độ tâm để bấm vào là tới đúng vị trí, và tổng công
        // suất cả nhóm (cộng công suất từng máy biến áp ghi trong tên, VD "(25+25MVA)" -> 50). Trạm
        // chưa ghi công suất trong tên (đa số nhóm Quy hoạch) thì bỏ qua, không tính vào tổng.
        $tbaTheoKv = [];
        foreach ($lopTbaTheoKv as $kv => $theoTrangThai) {
            foreach ($theoTrangThai as $tt => $dsLopId) {
                // Sắp theo số thứ tự ghi ở đầu tên ("1. TBA…", "2. TBA…"), không phải theo id hay theo
                // tên (chuỗi) — id nhập liệu chưa chắc theo đúng thứ tự 1,2,3… ghi trong tên gốc (VD
                // TBA 220kV), còn so theo tên thì "10." lại đứng trước "2.".
                $ds = DoiTuongHaTang::whereIn('lop_id', $dsLopId)
                    ->orderBy('id')
                    ->get(['id', 'ten', 'tam_vi_do', 'tam_kinh_do'])
                    ->sortBy(fn ($d) => preg_match('/^(\d+)\./', (string) $d->ten, $mSo) ? (int) $mSo[1] : $d->id)
                    ->values();

                $tongMva = 0;
                $dsRaSoat = $ds->map(function ($d) use (&$tongMva) {
                    if (preg_match('/\(([\d+]+)\s*MVA\)/ui', (string) $d->ten, $m)) {
                        $tongMva += array_sum(array_map('intval', explode('+', $m[1])));
                    }

                    return [
                        'ten' => $d->ten ?: '(chưa đặt tên)',
                        'vi_do' => $d->tam_vi_do,
                        'kinh_do' => $d->tam_kinh_do,
                    ];
                })->values();

                $tbaTheoKv[$kv][$tt] = [
                    'ds' => $dsRaSoat,
                    'tong_mva' => $tongMva,
                    'lop_id' => $dsLopId,
                    'hien_thi' => collect($dsLopId)->every(fn ($id) => (bool) ($hienThiTheoId[$id] ?? true)),
                ];
            }
        }

        $tatCaKv = collect(array_keys($tuyenTheoKv))->merge(array_keys($tbaTheoKv))->unique()->sortDesc()->values();

        $trong = ['ds' => [], 'tong_mva' => 0, 'lop_id' => [], 'hien_thi' => true];
        $ds = $tatCaKv->map(fn ($kv) => [
            'kv' => $kv,
            'duong_day' => [
                'hien_trang' => $tuyenTheoKv[$kv]['hien_trang'] ?? [],
                'quy_hoach' => $tuyenTheoKv[$kv]['quy_hoach'] ?? [],
            ],
            'tba' => [
                'hien_trang' => $tbaTheoKv[$kv]['hien_trang'] ?? $trong,
                'quy_hoach' => $tbaTheoKv[$kv]['quy_hoach'] ?? $trong,
            ],
        ])->values();

        return response()->json($ds);
    }

    /** Rút gọn tên lớp thành tên tuyến/đoạn dễ đọc để hiển thị trong menu thống kê */
    private function tenTuyenHaTang(string $ten): string
    {
        $s = preg_replace('/^(Đường dây|TBA)\s*\d+\s*kV(\s*—\s*(Hiện trạng|Quy hoạch))?\s*—\s*/u', '', $ten);
        $s = trim(preg_replace('/\s*—\s*(điểm|đường)$/u', '', trim($s)), " —");

        $nhan = [
            'điểm' => 'Vị trí cột (dùng chung)',
            'đường' => 'Tuyến (chưa đặt tên)',
            'khác' => 'Đoạn khác (chưa đặt tên)',
        ];

        if (isset($nhan[$s])) {
            return $nhan[$s];
        }

        return $s !== '' ? $s : 'Toàn bộ (gộp chung)';
    }
}
