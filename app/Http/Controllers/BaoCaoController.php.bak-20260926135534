<?php

namespace App\Http\Controllers;

use App\Models\BaoCaoDuAn;
use App\Models\DuAn;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class BaoCaoController extends Controller
{
    public function index(Request $request)
    {
        $user = $request->user();

        if ($user->vai_tro === 'chu_dau_tu') {
            $dsDuAn = $user->duAn()->orderBy('ten')->get();

            $baoCao = BaoCaoDuAn::with('duAn')
                ->whereIn('du_an_id', $dsDuAn->pluck('id'))
                ->latest()
                ->paginate(20)
                ->withQueryString();

            return view('bao-cao.index', [
                'dsDuAn' => $dsDuAn,
                'baoCao' => $baoCao,
            ]);
        }

        $baoCao = BaoCaoDuAn::with(['duAn', 'nguoiBaoCao'])
            ->when($request->query('du_an_id'), fn ($q, $v) => $q->where('du_an_id', $v))
            ->when($request->query('tu_ngay'), fn ($q, $v) => $q->whereDate('created_at', '>=', $v))
            ->when($request->query('den_ngay'), fn ($q, $v) => $q->whereDate('created_at', '<=', $v))
            ->latest()
            ->paginate(20)
            ->withQueryString();

        return view('bao-cao.index', [
            'baoCao' => $baoCao,
            'dsDuAnLoc' => DuAn::withTrashed()->orderBy('ten')->get(['id', 'ten']),
        ]);
    }

    public function store(Request $request)
    {
        $user = $request->user();

        if ($user->vai_tro !== 'chu_dau_tu') {
            abort(403, 'Chỉ tài khoản chủ đầu tư mới nộp được báo cáo.');
        }

        $data = $request->validate([
            'du_an_id' => ['required', 'integer', 'exists:du_an,id'],
            'noi_dung' => ['nullable', 'string', 'max:5000'],
            'tien_do' => ['required', 'integer', 'between:0,100'],
            'pl_chu_truong' => ['nullable', 'boolean'],
            'pl_dat_dai' => ['nullable', 'boolean'],
            'pl_moi_truong' => ['nullable', 'boolean'],
            'pl_pccc' => ['nullable', 'boolean'],
            'pl_xay_dung' => ['nullable', 'boolean'],
        ], [], ['du_an_id' => 'dự án', 'tien_do' => 'tiến độ']);

        // Global scope trên DuAn tự lọc theo chu_dau_tu_id — dự án của người khác sẽ không tìm
        // thấy (404) thay vì 403, nhưng cùng chặn được việc báo cáo hộ dự án không phải của mình.
        $duAn = DuAn::findOrFail($data['du_an_id']);

        $moc = [
            'pl_chu_truong' => $request->boolean('pl_chu_truong'),
            'pl_dat_dai' => $request->boolean('pl_dat_dai'),
            'pl_moi_truong' => $request->boolean('pl_moi_truong'),
            'pl_pccc' => $request->boolean('pl_pccc'),
            'pl_xay_dung' => $request->boolean('pl_xay_dung'),
        ];

        DB::transaction(function () use ($user, $duAn, $data, $moc) {
            BaoCaoDuAn::create([
                'du_an_id' => $duAn->id,
                'nguoi_bao_cao_id' => $user->id,
                'noi_dung' => $data['noi_dung'] ?: null,
                'tien_do' => $data['tien_do'],
                ...$moc,
            ]);

            $duAn->update([
                'tien_do' => $data['tien_do'],
                'nguoi_cap_nhat_id' => $user->id,
                ...$moc,
            ]);
        });

        return back()->with('thong_bao', "Đã nộp báo cáo cho dự án \"{$duAn->ten}\".");
    }
}
