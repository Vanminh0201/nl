<?php

namespace App\Support;

use App\Models\CaiDat;
use App\Models\DuAn;
use Carbon\CarbonImmutable;
use Illuminate\Database\Eloquent\Builder;

/**
 * Quy ước chung của báo cáo sản lượng điện tháng: dự án nguồn điện đã vận hành báo cáo sản lượng tháng
 * trước, hạn gửi ngày N của tháng sau (quản trị chỉnh ở Cài đặt báo cáo). Số liệu lưu kWh, thống kê
 * hiển thị triệu kWh.
 */
final class BaoCaoSanLuong
{
    public const TRANG_THAI_VAN_HANH = 'Đã đi vào hoạt động';

    public static function loaiHinh(): array
    {
        return config('duan.ban_do.loai_hinh_nguon_dien', []);
    }

    /** Dự án phải báo cáo: nguồn điện đã vận hành, cộng dự án đã có số liệu (đổi trạng thái vẫn giữ lịch sử) */
    public static function duAn(?Builder $q = null): Builder
    {
        return ($q ?? DuAn::query())
            ->whereIn('loai_hinh', self::loaiHinh())
            ->where(fn (Builder $q) => $q->where('trang_thai', self::TRANG_THAI_VAN_HANH)->orWhereHas('sanLuongThang'));
    }

    /** Dự án đang vận hành (không gồm dự án chỉ còn số liệu cũ) */
    public static function duAnDangVanHanh(?Builder $q = null): Builder
    {
        return ($q ?? DuAn::query())->whereIn('loai_hinh', self::loaiHinh())->where('trang_thai', self::TRANG_THAI_VAN_HANH);
    }

    public static function ngayHan(): int
    {
        return max(1, min(28, (int) CaiDat::lay('bao_cao_san_luong.han_nop', 10)));
    }

    /** Hạn gửi sản lượng tháng $ky: ngày N của tháng sau */
    public static function hanNop(KyThang $ky): CarbonImmutable
    {
        return $ky->sau()->tuNgay->setDay(self::ngayHan());
    }

    public static function quaHan(KyThang $ky): bool
    {
        return CarbonImmutable::now(KyBaoCao::MUI_GIO)->greaterThan(self::hanNop($ky)->endOfDay());
    }

    /** Tháng đang đến kỳ báo cáo: tháng trước (tháng này chưa kết thúc) */
    public static function kyCanBao(): KyThang
    {
        return KyThang::hienTai()->truoc();
    }

    /** Tháng đã kết thúc thì mới báo cáo / nhập được sản lượng */
    public static function nhapDuoc(KyThang $ky): bool
    {
        return $ky->somHon(KyThang::hienTai());
    }

    public static function batDauApDung(): KyThang
    {
        return KyThang::tuMa(CaiDat::lay('bao_cao_san_luong.thang_bat_dau')) ?? self::kyCanBao();
    }

    /** Tháng đầu tiên tài khoản phải báo cáo: muộn hơn giữa tháng bắt đầu áp dụng và tháng tạo tài khoản */
    public static function batDauBaoCao(?\DateTimeInterface $taoTaiKhoan): KyThang
    {
        $ky = self::batDauApDung();
        if ($taoTaiKhoan) {
            $kyTao = KyThang::chuaNgay(CarbonImmutable::instance($taoTaiKhoan)->setTimezone(KyBaoCao::MUI_GIO));
            if ($ky->somHon($kyTao)) {
                $ky = $kyTao;
            }
        }

        return $ky;
    }

    /**
     * Đọc số người dùng gõ hoặc dán từ Excel: "12.345.678", "12,345,678", "12345678", "1.234,5" đều được.
     * Trả null nếu ô trống, false nếu không phải số.
     */
    public static function docSo(mixed $chu): float|null|false
    {
        $s = preg_replace('/[\s\x{00A0}]+/u', '', (string) $chu);
        if ($s === '') {
            return null;
        }
        if (str_contains($s, '.') && str_contains($s, ',')) {
            // dấu xuất hiện sau cùng là dấu thập phân
            $s = strrpos($s, ',') > strrpos($s, '.') ? str_replace(['.', ','], ['', '.'], $s) : str_replace(',', '', $s);
        } elseif (preg_match('/^\d{1,3}(\.\d{3})+$/', $s)) {
            $s = str_replace('.', '', $s);
        } elseif (preg_match('/^\d{1,3}(,\d{3})+$/', $s)) {
            $s = str_replace(',', '', $s);
        } else {
            $s = str_replace(',', '.', $s);
        }

        return is_numeric($s) && (float) $s >= 0 ? round((float) $s, 1) : false;
    }

    public static function so(?float $v, int $le = 0): string
    {
        return $v === null ? '' : number_format($v, $le, ',', '.');
    }

    /** kWh → triệu kWh */
    public static function trieu(?float $kwh): ?float
    {
        return $kwh === null ? null : $kwh / 1e6;
    }
}
