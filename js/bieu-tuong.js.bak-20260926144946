    san_bay: '<polygon points="3,11 21,4 14,21 11,13"/><line x1="11" y1="13" x2="21" y2="4"/>',
    truong_hoc: '<polygon points="12,4 22,9 12,14 2,9"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/><line x1="22" y1="9" x2="22" y2="16"/>',
    benh_vien: '<rect x="3" y="3" width="18" height="18" rx="3"/><line x1="12" y1="7" x2="12" y2="17"/><line x1="7" y1="12" x2="17" y2="12"/>',
    nong_nghiep: '<line x1="12" y1="21" x2="12" y2="9"/><path d="M12 9c-3 0-5-2-5-5 3 0 5 2 5 5z"/><path d="M12 9c3 0 5-2 5-5-3 0-5 2-5 5z"/><path d="M12 14c-3 0-5-2-5-5 3 0 5 2 5 5z"/><path d="M12 14c3 0 5-2 5-5-3 0-5 2-5 5z"/>',
    chan_nuoi: '<circle cx="7" cy="8" r="1.6"/><circle cx="12" cy="6" r="1.6"/><circle cx="17" cy="8" r="1.6"/><path d="M12 12c-3 0-5 2-5 4.5S9 21 12 21s5-1 5-4.5S15 12 12 12z"/>',
    thuy_san: '<path d="M3 12c4-5 10-6 14-3l4 3-4 3c-4 3-10 2-14-3z"/><circle cx="15" cy="11" r="0.8" fill="currentColor" stroke="none"/><path d="M3 12l-2-3m2 3l-2 3"/>',
    khi_dot: '<path d="M12 2c1 4-3 5-3 9a3 3 0 0 0 6 0c0-1-1-2-1-3 2 1 3 3 3 5a5 5 0 0 1-10 0C7 8 10 6 12 2z"/>',
    than: '<rect x="4" y="14" width="6" height="6" rx="1"/><rect x="10" y="10" width="6" height="10" rx="1"/><rect x="16" y="15" width="4" height="5" rx="1"/>',
    logistics: '<rect x="2" y="10" width="11" height="7"/><path d="M13 12h4l3 3v2h-7z"/><circle cx="6" cy="19" r="1.6"/><circle cx="17" cy="19" r="1.6"/>',
    vien_thong: '<line x1="12" y1="22" x2="12" y2="12"/><path d="M8 12a4 4 0 0 1 8 0"/><path d="M5 9a8 8 0 0 1 14 0"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>',
    moi_truong: '<circle cx="12" cy="12" r="9"/><path d="M8 16c0-5 3-8 8-8 0 5-3 8-8 8z"/>',
    an_ninh: '<path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z"/><polyline points="8.5,12 11,14.5 15.5,9.5"/>',
    nuoc_sach: '<path d="M8 3h8v4l3 4v10H5V11l3-4z"/><line x1="8" y1="7" x2="16" y2="7"/>',
    cau_duong: '<path d="M2 17c3-6 6-9 10-9s7 3 10 9"/><line x1="2" y1="21" x2="22" y2="21"/><line x1="6" y1="21" x2="6" y2="14"/><line x1="12" y1="21" x2="12" y2="11"/><line x1="18" y1="21" x2="18" y2="14"/>',
    may_tinh: '<rect x="7" y="7" width="10" height="10" rx="1"/><line x1="9" y1="3" x2="9" y2="7"/><line x1="15" y1="3" x2="15" y2="7"/><line x1="9" y1="17" x2="9" y2="21"/><line x1="15" y1="17" x2="15" y2="21"/><line x1="3" y1="9" x2="7" y2="9"/><line x1="3" y1="15" x2="7" y2="15"/><line x1="17" y1="9" x2="21" y2="9"/><line x1="17" y1="15" x2="21" y2="15"/>',
    ngan_hang: '<polygon points="12,2 22,8 2,8"/><line x1="4" y1="8" x2="4" y2="20"/><line x1="9" y1="8" x2="9" y2="20"/><line x1="15" y1="8" x2="15" y2="20"/><line x1="20" y1="8" x2="20" y2="20"/><line x1="2" y1="21" x2="22" y2="21"/>',
    sao: '<polygon points="12,2 15,9 22,9 16.5,13.5 18.5,21 12,17 5.5,21 7.5,13.5 2,9 9,9"/>',
    co: '<line x1="5" y1="21" x2="5" y2="3"/><path d="M5 4h14l-4 4 4 4H5z"/>',
  };

  var HINH_NHAN = {
    diem_moc: 'Điểm mốc', tram_dien: 'Trạm biến áp / cột điện', mba: 'Máy biến áp (2 vòng tròn)', toa_nha: 'Toà nhà, văn phòng',
    kho: 'Nhà kho, kho bãi', canh_bao: 'Cảnh báo, lưu ý',
    ccn: 'Nhà xưởng (mái răng cưa)', kcn: 'Cụm nhiều khối nhà', che_bien: 'Lá, chế biến nông sản',
    vlxd: 'Xếp tấm vật liệu', khoang_san: 'Dãy núi, khai khoáng', thuy_dien: 'Giọt nước',
    dien_gio: 'Cánh quạt gió', dien_mat_troi: 'Mặt trời', det_may: 'Áo, dệt may', khac: 'Khối lục giác',
    nha_may: 'Nhà máy, mái tam giác', cang_bien: 'Mỏ neo, cảng biển', san_bay: 'Máy bay',
    truong_hoc: 'Mũ tốt nghiệp', benh_vien: 'Chữ thập y tế', nong_nghiep: 'Bông lúa',
    chan_nuoi: 'Chân thú, chăn nuôi', thuy_san: 'Con cá', khi_dot: 'Ngọn lửa, khí đốt',
    than: 'Khối than xếp', logistics: 'Xe tải', vien_thong: 'Cột phát sóng',
    moi_truong: 'Lá trong vòng tròn, môi trường', an_ninh: 'Khiên, an ninh', nuoc_sach: 'Bồn nước',
    cau_duong: 'Cầu đường', may_tinh: 'Chip, công nghệ', ngan_hang: 'Toà nhà cột, ngân hàng',
    sao: 'Ngôi sao', co: 'Lá cờ',
  };

  function danhSach() {
    return window.DS_BIEU_TUONG || [];
  }

  function timBieuTuong(ma) {
    var ds = danhSach();
    for (var i = 0; i < ds.length; i++) {
      if (ds[i].ma === ma) return ds[i];
    }

    return null;
  }

  function hinhCuaMa(ma) {
    var b = timBieuTuong(ma);

    return b ? b.hinh : 'khac';
  }

  /** Vẽ trực tiếp 1 hình vẽ sẵn trong thư viện HINH theo khoá (không qua tra cứu mã biểu tượng) */
  function svgHinh(hinh, kichThuoc) {
    kichThuoc = kichThuoc || 18;
    var noiDung = HINH[hinh] || HINH.khac;

    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="' + kichThuoc + '" height="' + kichThuoc + '" ' + NET + '>' + noiDung + '</svg>';
  }

  /** Vẽ ảnh do quản trị tự tải lên, tô màu bằng CSS mask-image để hoà cùng phong cách icon SVG viết sẵn */
  function anhTaiLen(url, kichThuoc) {
    kichThuoc = kichThuoc || 18;
    // Bọc URL bằng nháy đơn cho url() CSS vì thuộc tính style bên ngoài dùng nháy kép — nếu lẫn nháy
    // kép trong URL sẽ làm hỏng cấu trúc HTML của thẻ (đóng sớm thuộc tính style).
    var u = String(url).replace(/"/g, '%22').replace(/'/g, '%27');

    return '<span class="bieu-tuong-anh" style="width:' + kichThuoc + 'px;height:' + kichThuoc + 'px;-webkit-mask-image:url(\'' + u + '\');mask-image:url(\'' + u + '\')"></span>';
  }

  function svgBieuTuong(ma, kichThuoc) {
    var b = timBieuTuong(ma);
    if (b && b.tep_url) return anhTaiLen(b.tep_url, kichThuoc);

    return svgHinh(hinhCuaMa(ma), kichThuoc);
  }

  function badgeHtml(ma, mau, kichThuoc) {
    kichThuoc = kichThuoc || 26;
    // TBA/máy biến áp dùng nền vuông thay vì tròn để nổi bật, phân biệt ngay với các điểm khác
    var lop = 'bieu-tuong-badge' + (hinhCuaMa(ma) === 'mba' ? ' bieu-tuong-badge-vuong' : '');

    return '<span class="' + lop + '" style="width:' + kichThuoc + 'px;height:' + kichThuoc + 'px;background:' + mau + '">'
      + svgBieuTuong(ma, Math.round(kichThuoc * 0.6)) + '</span>';
  }

  function divIcon(ma, mau, kichThuoc) {
    kichThuoc = kichThuoc || 26;

    return L.divIcon({
      className: 'bieu-tuong-du-an',
      html: badgeHtml(ma, mau, kichThuoc),
      iconSize: [kichThuoc, kichThuoc],
      iconAnchor: [kichThuoc / 2, kichThuoc / 2],
    });
  }

  function badgeHinhHtml(hinh, kichThuoc) {
    kichThuoc = kichThuoc || 26;
    var lop = 'bieu-tuong-badge' + (hinh === 'mba' ? ' bieu-tuong-badge-vuong' : '');

    return '<span class="' + lop + '" style="width:' + kichThuoc + 'px;height:' + kichThuoc + 'px;background:#5b6773">'
      + svgHinh(hinh, Math.round(kichThuoc * 0.6)) + '</span>';
  }

  /**
   * Bộ chọn biểu tượng dạng lưới bấm-chọn (giống bấm chọn màu): huy hiệu hiện tại vừa là nút mở
   * bảng vừa là ô xem trước, bấm 1 ô trong bảng để chọn ngay, không cần đọc danh sách chữ.
   *
   * el: phần tử rỗng sẽ được vẽ bộ chọn vào bên trong, đọc cấu hình qua data-*:
   *   data-chon: mã đang chọn ban đầu.
   *   data-ten:  tên trường (name) cho ô input ẩn thật sự gửi lên form — bỏ trống nếu chỉ dùng nội bộ
   *              bằng JS (không cần gửi kèm form), tránh gửi thừa trường không tên lên server.
   *   data-form: id của <form> ngoài (nếu input ẩn nằm ngoài form đó, dùng thuộc tính form="").
   *   data-mau:  id ô <input type=color> màu liền kề — chỉ áp dụng khi che="bieu_tuong", để huy
   *              hiệu tô đúng màu của loại hình. Bỏ trống thì dùng màu trung tính.
   * che: 'bieu_tuong' (mặc định, chọn theo danh sách CRUD ở trang Danh mục) hoặc 'hinh' (chọn 1 hình
   *      vẽ sẵn trong thư viện, dùng cho chính form CRUD biểu tượng).
   */
  function khoiTaoBoChon(el, che) {
    che = che || 'bieu_tuong';
    var ten = el.dataset.ten || '';
    var formId = el.dataset.form || '';
    var mauEl = el.dataset.mau ? document.getElementById(el.dataset.mau) : null;
    var giaTri = el.dataset.chon || (che === 'hinh' ? 'khac' : 'diem_moc');

    function mau() { return mauEl ? mauEl.value : '#5b6773'; }
    function badge(ma, kichThuoc) { return che === 'hinh' ? badgeHinhHtml(ma, kichThuoc) : badgeHtml(ma, mau(), kichThuoc); }
    function dsTuyChon() {
      return che === 'hinh'
        ? Object.keys(HINH).map(function (h) { return { ma: h, ten: HINH_NHAN[h] || h }; })
        : danhSach();
    }

    el.innerHTML = '<input type="hidden"' + (formId ? ' form="' + formId + '"' : '') + (ten ? ' name="' + ten + '"' : '')
      + ' class="bt-chon-gt" value="' + giaTri + '">'
      + '<button type="button" class="bt-chon-nut"></button>'
      + '<div class="bt-chon-bang" hidden></div>';

    var gt = el.querySelector('.bt-chon-gt');
    var nut = el.querySelector('.bt-chon-nut');
    var bang = el.querySelector('.bt-chon-bang');

    function veNut() { nut.innerHTML = badge(giaTri, 26); nut.title = 'Bấm để chọn biểu tượng'; }
    function veBang() {
      bang.innerHTML = dsTuyChon().map(function (b) {
        return '<button type="button" class="bt-chon-o' + (b.ma === giaTri ? ' dang-chon' : '') + '" data-ma="' + b.ma + '" title="' + b.ten + '">'
          + badge(b.ma, 24) + '</button>';
      }).join('');
    }

    veNut();
    veBang();

    function dinhViBang() {
      var r = nut.getBoundingClientRect();
      var trai = Math.min(r.left, window.innerWidth - 220);
      bang.style.top = (r.bottom + 4) + 'px';
      bang.style.left = Math.max(4, trai) + 'px';
    }

    nut.addEventListener('click', function (e) {
      e.stopPropagation();
      var dangAn = bang.hidden;
      Array.prototype.forEach.call(document.querySelectorAll('.bt-chon-bang'), function (b) { b.hidden = true; });
      bang.hidden = !dangAn;
      if (!bang.hidden) dinhViBang();
    });

    bang.addEventListener('click', function (e) {
      var o = e.target.closest('.bt-chon-o');
      if (!o) return;
      giaTri = o.dataset.ma;
      gt.value = giaTri;
      bang.hidden = true;
      veNut();
      veBang();
      gt.dispatchEvent(new Event('change', { bubbles: true }));
    });

    if (mauEl) mauEl.addEventListener('input', function () { veNut(); veBang(); });
  }

  document.addEventListener('click', function () {
    Array.prototype.forEach.call(document.querySelectorAll('.bt-chon-bang'), function (b) { b.hidden = true; });
  });

  window.BieuTuongLoaiHinh = {
    svg: svgBieuTuong, svgHinh: svgHinh, badgeHtml: badgeHtml, badgeHinhHtml: badgeHinhHtml, divIcon: divIcon,
    khoiTaoBoChon: khoiTaoBoChon,
  };
})();
