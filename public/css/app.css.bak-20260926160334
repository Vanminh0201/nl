:root{
  --ink:#17202a; --ink-2:#4a5866; --ink-3:#7d8a97;
  --page:#e9ebe7; --surface:#fff; --line:#ccd2cd; --line-soft:#e2e6e1;
  --primary:#1f4b6e; --signal:#b4531c; --ok:#2f6b4f; --warn:#96701a; --danger:#8f2c1e;
  --radius:3px; --shadow:0 1px 0 rgba(23,32,42,.06),0 8px 24px rgba(23,32,42,.10);
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--page);color:var(--ink);
  font-family:"Segoe UI",system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;font-size:14px;line-height:1.5}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
a{color:var(--primary)}
h1,h2,h3{margin:0}

.app{display:flex;flex-direction:column;min-height:100dvh}
header.bar{display:flex;align-items:center;gap:14px;padding:9px 14px;background:var(--ink);color:#f2f4f2;flex:0 0 auto}
.bar .brand{font-size:14px;font-weight:600;white-space:nowrap}
.bar .org{font-size:12px;color:#9daab3;white-space:nowrap}
.bar .spacer{flex:1}

.muc-luc{position:relative}
.muc-luc-nut{background:none;border:1px solid rgba(255,255,255,.2);color:#f2f4f2;
  padding:6px 11px;border-radius:var(--radius);font-size:13px;white-space:nowrap}
.muc-luc-nut:hover{border-color:rgba(255,255,255,.4)}
.muc-luc-nut .mui{opacity:.85}
.muc-luc-bang{position:absolute;top:calc(100% + 6px);left:0;z-index:1000;background:var(--ink);
  border:1px solid rgba(255,255,255,.2);border-radius:var(--radius);padding:11px 14px;
  display:flex;flex-direction:column;gap:3px;box-shadow:var(--shadow);min-width:260px}
/* [hidden] mặc định của trình duyệt bị "display:flex" ở trên đè mất (cùng độ ưu tiên, luật sau
   trong file thắng) — phải ghi đè tường minh, nếu không bảng luôn hiện bất kể thuộc tính hidden. */
.muc-luc-bang[hidden]{display:none}
/* Khối bên phải đầu trang (VD "Cài đặt") mở bảng lệch sang trái, không thì tràn ra ngoài mép phải */
.cai-dat .muc-luc-bang{left:auto;right:0}
.cai-dat .me{font-size:12px;color:#9daab3;white-space:nowrap}
.bar nav{display:flex;background:rgba(255,255,255,.08);border-radius:var(--radius);padding:2px}
.bar nav a{color:#c3ccd3;padding:5px 12px;border-radius:2px;font-size:13px;text-decoration:none}
.bar nav a.on{background:#f2f4f2;color:var(--ink);font-weight:600}
.bar .me{font-size:12px;color:#9daab3}

.btn{border:1px solid var(--line);background:var(--surface);padding:6px 12px;border-radius:var(--radius);
  text-decoration:none;color:var(--ink);display:inline-block}
.btn:hover{border-color:var(--ink-3)}
.btn.primary{background:var(--primary);border-color:var(--primary);color:#fff;font-weight:600}
.btn.primary:hover{background:#173954}
.btn.ghost{background:transparent;border-color:#3a4652;color:#dbe2e6}
.btn.ghost:hover{border-color:#7d8a97}
.btn.danger{color:var(--danger);border-color:#d9bcb6}
.btn.sm{padding:3px 9px;font-size:12.5px}

main{flex:1;min-height:0;display:flex;flex-direction:column}
.pad{padding:14px}
.flash{margin:10px 14px 0;padding:9px 13px;border-radius:var(--radius);background:#eaf3ee;border:1px solid #b9d5c5;color:#1f4a35;font-size:13px}
.loi{margin:0 0 12px;padding:9px 13px;border-radius:var(--radius);background:#fbeceb;border:1px solid #e0bdb6;color:var(--danger);font-size:13px}
.loi ul{margin:5px 0 0;padding-left:18px}

/* bản đồ */
.mapview{display:flex;flex:1;min-height:0}
aside{width:330px;flex:0 0 330px;background:var(--surface);border-right:1px solid var(--line);display:flex;flex-direction:column;
  min-height:0;position:relative;transition:flex-basis .18s ease,width .18s ease}
aside.thu-gon{width:0;flex-basis:0;border-right:0;overflow:hidden}
.aside-tab{display:flex;border-bottom:1px solid var(--line-soft);padding:0 34px 0 12px}
.aside-tab-nut{border:0;background:none;padding:10px 4px;margin-right:16px;font-size:13px;font-weight:600;
  color:var(--ink-3);cursor:pointer;border-bottom:2px solid transparent}
.aside-tab-nut:hover{color:var(--ink)}
.aside-tab-nut.chon{color:var(--primary);border-bottom-color:var(--primary)}
.aside-hd{padding:10px 12px;border-bottom:1px solid var(--line-soft);display:flex;flex-direction:column;gap:8px}
.aside-hd input,.aside-hd select{width:100%;padding:7px 9px;border:1px solid var(--line);border-radius:var(--radius);background:#fbfcfb}
.aside-hd .hai{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.count{font-size:12px;color:var(--ink-2)}
.ds{overflow:auto;flex:1;min-height:0}
.ds .muc{display:grid;grid-template-columns:4px 1fr auto;gap:9px;align-items:center;padding:9px 12px 9px 0;border-bottom:1px solid var(--line-soft);cursor:pointer}
.ds .muc:hover{background:#f4f6f4}
.ds .muc.chon{background:#eaf0f5}
.ds .muc.an{opacity:.45}
.ds .muc .vach{background:var(--c,#999)}
.ds .muc h3{font-size:13.5px;font-weight:600;line-height:1.35}
.ds .muc p{margin:2px 0 0;font-size:12px;color:var(--ink-2)}
.ds .muc .meta{margin-top:4px;font-size:11.5px;color:var(--ink-3);display:flex;gap:10px;flex-wrap:wrap}
.trong{padding:26px 16px;color:var(--ink-2);font-size:13px}

/* Menu thống kê lưới điện (500/220/110kV) ở trang Bản đồ — cây 3 cấp: cấp điện áp > ĐZ|TBA
   (Hiện trạng/Quy hoạch) > tuyến hoặc TBA cụ thể, bấm vào mục lá là bay tới đúng vị trí. */
.httier-hd{display:flex;align-items:center;gap:7px;padding:10px 12px;border-bottom:1px solid var(--line-soft);
  cursor:pointer;font-weight:700;font-size:13.5px;background:#fbfcfb}
.httier-hd:hover{background:#f2f5f2}
.httier-hd .mui{transition:transform .15s;color:var(--ink-3);font-size:11px}
.httier.mo .httier-hd .mui{transform:rotate(90deg)}
.httier-hd .httier-dem{font-weight:400;font-size:11.5px;color:var(--ink-3)}
.httier-body{display:none}
.httier.mo .httier-body{display:block}
.htnhom-hd{display:flex;align-items:center;gap:7px;padding:8px 12px 8px 22px;border-bottom:1px solid var(--line-soft);
  cursor:pointer;font-size:12.5px;font-weight:600;color:var(--ink-2)}
.htnhom-hd:hover{background:#f4f6f4}
.htnhom-hd .mui{transition:transform .15s;color:var(--ink-3);font-size:10px}
.htnhom.mo .htnhom-hd .mui{transform:rotate(90deg)}
.htnhom-body{display:none}
.htnhom.mo .htnhom-body{display:block}
.htmuc{display:flex;justify-content:space-between;gap:8px;padding:7px 12px 7px 34px;border-bottom:1px solid var(--line-soft);
  cursor:pointer;font-size:12.5px}
.htmuc:hover{background:#eaf0f5}
.htmuc .htmuc-dem{color:var(--ink-3);font-size:11px;white-space:nowrap}
.htmuc-phai{display:flex;align-items:center;gap:7px;flex:0 0 auto}
.ds-troi{padding:10px 12px;color:var(--ink-3);font-size:12px}

/* Nút con mắt ẩn/hiện lớp ngay trong menu Lưới điện — chỉ quản trị/nhập liệu mới thấy (JS không
   vẽ nút này cho vai trò khác), bấm là gọi API bật/tắt hien_thi có sẵn của trang Lớp hạ tầng. */
.ht-mat{border:0;background:none;padding:2px;line-height:0;color:var(--primary);cursor:pointer;
  border-radius:3px;flex:0 0 auto}
.ht-mat:hover{background:#dfe7ea}
.ht-mat.dang-an{color:var(--ink-3)}
.ht-mat:disabled{opacity:.5;cursor:default}

.mapwrap{flex:1;position:relative;min-width:0}
#map{position:absolute;inset:0;background:#dfe3dd}
.maptools{position:absolute;right:10px;top:10px;z-index:600;display:flex;gap:6px}
.maptools .btn{box-shadow:0 1px 4px rgba(0,0,0,.2)}
.maphint{position:absolute;left:50%;top:12px;transform:translateX(-50%);z-index:600;background:var(--ink);color:#fff;
  padding:7px 14px;border-radius:var(--radius);font-size:13px;display:none;align-items:center;gap:12px;box-shadow:var(--shadow)}
.maphint.on{display:flex}
.maphint button{background:#3b4854;border:0;color:#fff;padding:4px 10px;border-radius:2px;font-size:12px}
/* Nhãn tên điểm/đường trên bản đồ — chỉ chữ, không khung/nền, viền trắng mỏng để đọc được trên mọi nền */
.leaflet-tooltip.nhan-ha-tang{background:transparent;border:none;box-shadow:none;padding:0;
  color:#17202a;font-weight:600;font-size:12px;
  text-shadow:0 0 3px #fff,0 0 3px #fff,0 0 3px #fff,0 0 3px #fff}
.leaflet-tooltip.nhan-ha-tang::before{display:none}
/* Nhãn tên dự án (bật ở Cài đặt) — cùng kiểu chữ viền trắng; dự án đã vận hành chữ đỏ như ở sidebar */
.leaflet-tooltip.nhan-du-an{background:transparent;border:none;box-shadow:none;padding:0;
  color:#17202a;font-weight:600;font-size:12px;white-space:nowrap;
  text-shadow:0 0 3px #fff,0 0 3px #fff,0 0 3px #fff,0 0 3px #fff}
.leaflet-tooltip.nhan-du-an::before{display:none}
.leaflet-tooltip.nhan-du-an.van-hanh{color:var(--danger)}
.legend{position:absolute;right:10px;bottom:22px;z-index:600;background:rgba(255,255,255,.95);border:1px solid var(--line);
  border-radius:var(--radius);padding:8px 10px;font-size:12px;max-width:200px}
.legend.thu-gon{display:none}
.legend-hd{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:-2px -4px 6px -2px}
.legend-hd span{font-size:11.5px;font-weight:600;color:var(--ink-2)}
.legend-hd button{border:0;background:none;cursor:pointer;font-size:14px;line-height:1;color:var(--ink-3);
  width:20px;height:20px;border-radius:50%;transition:background .15s,color .15s}
.legend-hd button:hover{background:#eef1ee;color:var(--ink)}
.legend h4{font-size:11.5px;font-weight:600;color:var(--ink-2);margin-bottom:6px}
.legend div{display:flex;align-items:center;gap:7px;padding:1.5px 0}
.legend i{width:9px;height:9px;border-radius:50%;flex:0 0 9px}
.legend i.duong{width:14px;height:3px;border-radius:2px}
.legend .chugiai-hang{padding:2px 0}
/* Khung chứa danh sách loại hình cũng là div nên dính luật "display:flex" ở trên, xếp các loại
   hình thành hàng ngang bị bóp méo — trả về xếp dọc từng dòng */
.legend #chuGiaiLoaiHinh{display:block}
.bieu-tuong-badge{display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;
  border:1.5px solid #fff;border-radius:50%;box-shadow:0 1px 3px rgba(0,0,0,.3);color:#fff}
/* TBA/máy biến áp dùng nền vuông thay vì tròn để phân biệt ngay với các điểm khác trên bản đồ */
.bieu-tuong-badge.bieu-tuong-badge-vuong{border-radius:5px}
/* Cánh quạt biểu tượng điện gió quay quanh trục (12,12) của khung vẽ 24×24 khi dự án đang vận
   hành; tốc độ lệch nhau giữa các điểm cho tự nhiên, không quay đồng loạt như một khối. */
.canh-quat{transform-box:view-box;transform-origin:12px 12px}
.bieu-tuong-du-an.dang-van-hanh .canh-quat{animation:quay-canh-quat 2.6s linear infinite}
.leaflet-marker-pane .bieu-tuong-du-an.dang-van-hanh:nth-child(3n) .canh-quat{animation-duration:3.1s}
.leaflet-marker-pane .bieu-tuong-du-an.dang-van-hanh:nth-child(3n+1) .canh-quat{animation-duration:2.2s}
@keyframes quay-canh-quat{to{transform:rotate(360deg)}}
/* Thuỷ điện đang vận hành: 2 dải sóng chảy ngược chiều nhau trong giọt nước (mỗi đoạn sóng dài
   8 đơn vị nên dịch đúng 8 là khớp vòng lặp, không bị giật). Chưa vận hành hoặc ở chú giải thì ẩn. */
.song-nuoc{display:none}
.bieu-tuong-du-an.dang-van-hanh .song-nuoc{display:inline}
.bieu-tuong-du-an.dang-van-hanh .song-nuoc path{animation:song-nuoc-chay 1.8s linear infinite}
.bieu-tuong-du-an.dang-van-hanh .song-nuoc path + path{animation-duration:2.6s;animation-direction:reverse}
@keyframes song-nuoc-chay{to{transform:translateX(-8px)}}
@media (prefers-reduced-motion:reduce){
  .bieu-tuong-du-an.dang-van-hanh .canh-quat,.bieu-tuong-du-an.dang-van-hanh .song-nuoc path{animation:none}
}
.legend .chugiai-ghi{display:block;font-size:11px;color:var(--ink-3);padding:1px 0;line-height:1.35}
.bieu-tuong-anh{display:inline-block;flex:0 0 auto;background-color:currentColor;
  -webkit-mask-size:contain;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;
  mask-size:contain;mask-repeat:no-repeat;mask-position:center}

/* Bộ chọn biểu tượng dạng lưới bấm-chọn (giống chọn màu): bấm huy hiệu hiện tại để mở bảng, bấm 1 ô để chọn */
.bt-chon{position:relative;display:inline-block;vertical-align:middle}
.bt-chon-nut{border:1px solid var(--line);background:var(--surface);border-radius:50%;padding:2px;
  cursor:pointer;line-height:0;display:inline-flex}
.bt-chon-nut:hover{border-color:var(--ink-3)}
.bt-chon-bang{position:fixed;z-index:500;background:var(--surface);
  border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);
  padding:8px;display:flex;flex-wrap:wrap;gap:5px;width:212px;max-height:220px;overflow:auto}
.bt-chon-bang[hidden]{display:none}
.bt-chon-o{border:1.5px solid transparent;background:none;border-radius:50%;padding:1px;cursor:pointer;line-height:0}
.bt-chon-o:hover{background:var(--page)}
.bt-chon-o.dang-chon{border-color:var(--primary)}
.canhbao{position:absolute;left:10px;bottom:78px;z-index:600;background:#fff5e6;border:1px solid #e0c48a;
  padding:7px 10px;border-radius:var(--radius);font-size:12px;max-width:280px;display:none}

.panel-dong{position:absolute;right:7px;top:7px;z-index:5;width:24px;height:24px;padding:0;line-height:22px;
  text-align:center;font-size:14px;border:1px solid var(--line);background:var(--surface);color:var(--ink-2);
  border-radius:50%;cursor:pointer;transition:background .15s,color .15s}
.panel-dong:hover{background:#eef1ee;color:var(--ink)}

.panel-mo{position:absolute;z-index:600;display:none;align-items:center;gap:7px;background:#fff;
  border:1px solid rgba(0,0,0,.08);border-radius:20px;padding:8px 16px 8px 14px;font-size:13px;font-weight:600;
  color:var(--ink);cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.18);transition:box-shadow .15s,transform .15s}
.panel-mo:hover{box-shadow:0 4px 12px rgba(0,0,0,.24);transform:translateY(-1px)}
.panel-mo.hien{display:inline-flex}
.panel-mo .ico{font-size:15px;line-height:1;color:var(--primary)}
#moKhungBen{left:10px;top:10px}
#moLegend{right:10px;bottom:22px}

/* Nút "Cài đặt" nổi trên bản đồ dùng chung kiểu ẩn/hiện .muc-luc của thanh đầu trang, nhưng
   đổi màu cho hợp nền sáng của công cụ bản đồ (thanh đầu trang có nền tối) */
.maptools .muc-luc-nut{background:#fff;border:1px solid rgba(0,0,0,.08);color:var(--ink);
  padding:8px 14px;box-shadow:0 2px 8px rgba(0,0,0,.18)}
.maptools .muc-luc-nut:hover{box-shadow:0 4px 12px rgba(0,0,0,.24)}
.maptools .muc-luc-bang{left:auto;right:0;background:#fff;color:var(--ink);min-width:220px}
.maptools .muc-luc-bang label{font-size:13px}

/* bảng */
.tablewrap{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);overflow:auto}
table{border-collapse:collapse;width:100%;font-size:13px;min-width:900px}
th,td{padding:9px 12px;text-align:left;border-bottom:1px solid var(--line-soft);border-right:1px solid var(--line-soft);vertical-align:top}
th:last-child,td:last-child{border-right:none}
th{background:#eef1ee;font-weight:600;font-size:12px;color:var(--ink-2);white-space:nowrap;position:sticky;top:0;
  border-bottom:2px solid var(--line)}
th a{color:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:5px}
th a:hover{color:var(--primary)}
th a .fleche{font-size:10px;opacity:.4}
th a:hover .fleche,th a .fleche.dang-sap{opacity:.9}
tbody tr:nth-child(even){background:#fafbf9}
tbody tr:hover{background:#eef3ee}
td.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
th.num{text-align:right}
th.num a{justify-content:flex-end}
tfoot td{background:#eef1ee;border-top:2px solid var(--line);border-bottom:none;font-weight:600}
tfoot td.num b{color:var(--primary)}
.tag{display:inline-flex;align-items:center;gap:5px;white-space:nowrap}
.tag i{width:8px;height:8px;border-radius:50%}
.thanhloc{display:flex;gap:8px;align-items:flex-end;margin-bottom:10px;flex-wrap:wrap}
.thanhloc label{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--ink-2)}
.thanhloc input,.thanhloc select{padding:6px 9px;border:1px solid var(--line);border-radius:var(--radius);background:#fff}
.thanhloc .grow{flex:1}

/* Thư viện biểu tượng (trang Danh mục) — lưới thẻ, mỗi thẻ 1 icon kèm form sửa nhanh.
   Trước đây chưa có CSS riêng nên xếp chồng dọc, nút Xoá kéo dài hết chiều ngang. */
.bt-luoi{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px}
.bt-oo{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);
  display:flex;flex-direction:column;overflow:hidden}
.bt-oo-them{border-style:dashed}
.bt-oo-form{padding:12px;display:flex;flex-direction:column;gap:7px;flex:1}
.xem-bieu-tuong-thuc{display:flex;justify-content:center}
.bt-oo-ten{width:100%;padding:6px 8px;border:1px solid var(--line);border-radius:var(--radius);
  background:#fbfcfb;font-size:12.5px;text-align:center}
.bt-oo-ma{display:block;text-align:center;font-size:11px;color:var(--ink-3)}
.bt-oo-dieu-khien{display:flex;align-items:center;justify-content:center;gap:7px;flex-wrap:wrap}
.bt-oo-xoa-tep{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--ink-2)}
.bt-oo-chan{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:3px}
.bt-oo-xoa{border-top:1px solid var(--line-soft)}

/* thống kê */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1px;background:var(--line);
  border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;margin-bottom:14px}
.kpi{background:var(--surface);padding:13px 15px}
.kpi b{display:block;font-size:25px;font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.kpi span{font-size:12px;color:var(--ink-2)}
.panels{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:14px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:13px 15px}
.panel h3{margin-bottom:11px;font-size:13.5px;font-weight:600}
.brow{display:grid;grid-template-columns:1fr auto;gap:9px;align-items:center;margin-bottom:7px;font-size:12.5px}
.brow .lbl{display:flex;align-items:center;gap:7px;min-width:0}
.brow .lbl span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.brow .val{font-variant-numeric:tabular-nums;color:var(--ink-2)}
.brow .track{grid-column:1/-1;height:7px;background:var(--line-soft);border-radius:4px;overflow:hidden;margin-top:-3px}
.brow .track i{display:block;height:100%;background:var(--c,var(--primary))}

/* biểu mẫu */
/* Mặc định không giới hạn chiều rộng — các trang danh sách/bảng/chi tiết dùng hết bề ngang màn
   hình. Trang nào cần hẹp lại (biểu mẫu nhiều trường, đăng nhập) tự đặt max-width riêng ở nơi gọi. */
.sheet{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius)}
.sheet-hd{padding:14px 18px;border-bottom:1px solid var(--line-soft)}
.sheet-hd h2{font-size:16px}
.sheet-bd{padding:16px 18px}
.sheet-ft{padding:12px 18px;border-top:1px solid var(--line-soft);display:flex;gap:8px;justify-content:flex-end}
fieldset{border:0;padding:0;margin:0 0 18px}
legend{font-size:12px;font-weight:600;color:var(--ink-2);margin-bottom:9px;padding:0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.grid .full{grid-column:1/-1}
label.f{display:flex;flex-direction:column;gap:4px;font-size:12.5px;color:var(--ink-2);min-width:0}
label.f input,label.f select,label.f textarea{padding:7px 9px;border:1px solid var(--line);border-radius:var(--radius);
  background:#fbfcfb;color:var(--ink);width:100%}
label.f textarea{resize:vertical;min-height:70px}
label.f .sai{color:var(--danger);font-size:11.5px}
.checks{display:flex;flex-wrap:wrap;gap:12px}
.checks label{display:flex;align-items:center;gap:6px;font-size:13px}
.hint{font-size:12px;color:var(--ink-3);margin:6px 0 0}

/* Danh sách chọn dự án (đăng ký chủ đầu tư) — hộp cuộn có ô tìm lọc theo tên ngay phía trên */
.ds-du-an-chon{max-height:220px;overflow:auto;border:1px solid var(--line);border-radius:var(--radius);
  padding:4px;background:#fbfcfb;margin-top:-6px}
.ds-du-an-chon label{display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:13px;
  border-radius:var(--radius);cursor:pointer}
.ds-du-an-chon label:hover{background:#eef1ee}
.ds-du-an-chon small{margin-left:auto;color:var(--ink-3);font-size:11px;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;padding-left:8px}
#mapchon{height:700px;border:1px solid var(--line);border-radius:var(--radius);margin-top:9px}

/* hộp thoại (thêm/sửa dạng CRUD chuẩn) */
dialog{border:0;border-radius:var(--radius);box-shadow:var(--shadow);padding:0;width:min(520px,calc(100vw - 32px));
  background:var(--surface);color:var(--ink)}
dialog::backdrop{background:rgba(23,32,42,.45)}
dialog .sheet-hd,dialog .sheet-bd,dialog .sheet-ft{padding-left:18px;padding-right:18px}
dialog .sheet-ft{display:flex;justify-content:flex-end;gap:8px}
.trang-thai{display:inline-flex;align-items:center;gap:5px;font-size:12.5px}
.trang-thai i{width:8px;height:8px;border-radius:50%;background:var(--ink-3)}
.trang-thai.bat i{background:var(--ok)}

/* chi tiết */
.row{display:grid;grid-template-columns:150px 1fr;gap:10px;padding:7px 0;border-bottom:1px solid #f0f2ef;font-size:13px}
.row dt{color:var(--ink-2)}
.row dd{margin:0}
.chips{display:flex;flex-wrap:wrap;gap:5px}
.chip{border:1px solid var(--line);border-radius:12px;padding:1px 9px;font-size:11.5px;color:var(--ink-2)}
.chip.co{background:#eaf3ee;border-color:#b9d5c5;color:var(--ok)}
.chip.cho{background:#fdf3e3;border-color:#e6cf9a;color:var(--warn)}
.tiendo{height:6px;background:var(--line-soft);border-radius:3px;overflow:hidden;margin-top:5px;max-width:240px}
.tiendo i{display:block;height:100%;background:var(--primary)}
.cot2{display:grid;grid-template-columns:1fr 380px;gap:14px;align-items:start}

.dangnhap{min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:20px}
.dangnhap .sheet{max-width:380px;width:100%}

@media (max-width:900px){
  .bar .org{display:none}
  .mapview{flex-direction:column}
  aside{width:auto;flex:0 0 46vh;border-right:0;border-bottom:1px solid var(--line)}
  aside.thu-gon{flex-basis:0;border-bottom:0}
  .legend,#moLegend{display:none!important}
  .grid{grid-template-columns:1fr}
  .cot2{grid-template-columns:1fr}
}

.phantrang{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--ink-2)}
.phantrang span[aria-disabled]{opacity:.45}

/* Báo cáo tuần */
.nav-dem{display:inline-block;min-width:17px;padding:0 5px;margin-left:5px;border-radius:9px;background:var(--signal);
  color:#fff;font-size:11px;font-weight:700;line-height:17px;text-align:center}
.chip.xanh{background:#e8f0f7;border-color:#b7cde0;color:var(--primary)}
.chip.do{background:#fbeceb;border-color:#e0bdb6;color:var(--danger)}
a.chip{text-decoration:none}
.bc-trang{display:flex;flex-direction:column;gap:14px}
.bc-canh-bao{padding:10px 14px;border-radius:var(--radius);background:#fbeceb;border:1px solid #e0bdb6;color:var(--danger);
  display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.bc-nhac{padding:9px 13px;border-radius:var(--radius);background:#e8f0f7;border:1px solid #b7cde0;display:flex;align-items:center;
  gap:7px;flex-wrap:wrap;font-size:13px}
.bc-thanh-ky{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.bc-thanh-ky select{padding:6px 9px;border:1px solid var(--line);border-radius:var(--radius);background:#fff}
.bc-chu-dai{white-space:pre-line;min-width:260px;font-size:12.5px}
.bc-chu-giai{display:flex;gap:14px;flex-wrap:wrap;margin-top:6px}
.bc-chu-giai span{display:inline-flex;align-items:center;gap:5px}
.bc-ma-tran{min-width:0}
.bc-ma-tran th,.bc-ma-tran td{text-align:center;padding:6px 8px}
.bc-ma-tran th:first-child,.bc-ma-tran td:first-child{text-align:left;min-width:220px}
.bc-ma-tran th a{justify-content:center}
.o-ky{display:inline-flex;width:24px;height:22px;align-items:center;justify-content:center;border-radius:3px;font-size:12px;
  font-weight:700;font-style:normal;text-decoration:none;border:1px solid var(--line);color:var(--ink-3);background:#fff}
.o-ky.co{background:#eaf3ee;border-color:#b9d5c5;color:var(--ok)}
.o-ky.xanh{background:#e8f0f7;border-color:#b7cde0;color:var(--primary)}
.o-ky.do{background:#fbeceb;border-color:#e0bdb6;color:var(--danger)}
.o-ky.thieu{background:#fdf3e3;border-color:#e6cf9a;color:var(--warn)}
.o-ky.na{border-style:dashed;color:var(--ink-3);background:transparent}

/* Trang lập báo cáo tuần: mục lục bên trái + nội dung; mỗi ô mang 1 trạng thái màu để người báo
   cáo thấy ngay chỗ cần làm — đỏ: bắt buộc chưa nhập · vàng: y nguyên tuần trước (cần rà soát) ·
   xanh: đã cập nhật tuần này. Trạng thái do JS trong bao-cao/soan.blade.php tính lại khi gõ. */
.bcs{--thieu:#b3261e;--thieu-nen:#fdf0ef;--thieu-vien:#eab5b0;--giu:#a86d12;--giu-nen:#fff8e6;--giu-vien:#ecd38f;
  --moi:#2f7a55;--moi-nen:#edf7f1;--moi-vien:#b9d9c6}
.bcs-dau{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:14px 14px 0;flex-wrap:wrap}
.bcs-dau h1{font-size:20px}
.bcs-dau-phu{font-size:12.5px;color:var(--ink-2);margin-top:3px}
.bcs-than{display:grid;grid-template-columns:260px minmax(0,1fr);gap:16px;padding:14px;align-items:start}

.bcs-nav{position:sticky;top:14px;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
  padding:8px;display:flex;flex-direction:column;gap:2px;max-height:calc(100dvh - 90px);overflow:auto}
.bcs-nav-tieu-de{font-size:11px;font-weight:700;color:var(--ink-3);text-transform:uppercase;letter-spacing:.05em;padding:4px 8px 6px}
.bcs-nav-muc{display:grid;grid-template-columns:24px minmax(0,1fr) auto;gap:6px;align-items:center;padding:7px 8px;
  border-radius:var(--radius);color:var(--ink);text-decoration:none;font-size:13px;line-height:1.3;border-left:3px solid transparent}
.bcs-nav-muc:hover{background:#f2f5f2}
.bcs-nav-muc.dang-xem{background:#eaf0f5;border-left-color:var(--primary);font-weight:600}
.bcs-nav-muc.bo-qua{color:var(--ink-3)}
.bcs-nav-so{font-size:11.5px;font-weight:700;color:var(--ink-3);text-align:center}
.bcs-nav-ten{overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.bcs-nav-dem{display:flex;gap:3px}
.bcs-dem{min-width:20px;height:20px;padding:0 6px;border-radius:10px;font-size:11px;font-weight:700;display:inline-flex;
  align-items:center;justify-content:center;color:#fff}
.bcs-dem.thieu{background:var(--thieu)}
.bcs-dem.giu{background:var(--giu)}
.bcs-dem.moi{background:var(--moi)}
.bcs-dem.bo-qua{background:transparent;color:var(--ink-3)}
.bcs-chu-giai{border-top:1px solid var(--line-soft);margin-top:6px;padding:8px 8px 2px;font-size:11.5px;color:var(--ink-2);
  display:flex;flex-direction:column;gap:5px}
.bcs-chu-giai div{display:flex;align-items:center;gap:7px}
.bcs-cham{width:10px;height:10px;border-radius:3px;display:inline-block;flex:0 0 10px}
.bcs-cham.thieu{background:var(--thieu)}
.bcs-cham.giu{background:var(--giu)}
.bcs-cham.moi{background:var(--moi)}

.bcs-chinh{display:flex;flex-direction:column;gap:14px;min-width:0}
.bcs-tong-quan{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.bcs-so-lieu{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:var(--radius);border:1px solid var(--line);
  background:var(--surface);text-align:left;font:inherit;color:var(--ink)}
button.bcs-so-lieu{cursor:pointer}
button.bcs-so-lieu:hover{box-shadow:var(--shadow)}
.bcs-so-lieu b{font-size:28px;line-height:1;font-variant-numeric:tabular-nums}
.bcs-so-lieu span{font-size:12.5px;color:var(--ink-2)}
.bcs-so-lieu.thieu{border-color:var(--thieu-vien);background:var(--thieu-nen)}
.bcs-so-lieu.thieu b{color:var(--thieu)}
.bcs-so-lieu.giu{border-color:var(--giu-vien);background:var(--giu-nen)}
.bcs-so-lieu.giu b{color:var(--giu)}
.bcs-so-lieu.moi{border-color:var(--moi-vien);background:var(--moi-nen)}
.bcs-so-lieu.moi b{color:var(--moi)}
.bcs-so-lieu.xong{background:var(--surface);border-color:var(--line)}
.bcs-so-lieu.xong b{color:var(--ink-3)}
.bcs-tong-quan-ghi{grid-column:1/-1;margin:0;font-size:12.5px;color:var(--ink-2)}
.mau-thieu{color:var(--thieu)}
.mau-giu{color:var(--giu)}
.mau-moi{color:var(--moi)}

.bcs-the{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);scroll-margin-top:14px}
.bcs-the-dau{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--line-soft);background:#f7f9f7}
summary.bcs-the-dau{cursor:pointer;list-style:none}
summary.bcs-the-dau::-webkit-details-marker{display:none}
.bcs-van-ban:not([open]) > .bcs-the-dau{border-bottom:0}
.bcs-so-la-ma{flex:0 0 34px;height:34px;border-radius:50%;background:var(--primary);color:#fff;font-weight:700;font-size:13px;
  display:flex;align-items:center;justify-content:center}
.bcs-the-ten{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px}
.bcs-the-ten h2{font-size:15.5px}
.bcs-the-meta{font-size:12px;color:var(--ink-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bcs-the-chip{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.bcs-chip{font-size:11.5px;font-weight:600;padding:2px 9px;border-radius:12px;white-space:nowrap;border:1px solid}
.bcs-chip.thieu{background:var(--thieu-nen);color:var(--thieu);border-color:var(--thieu-vien)}
.bcs-chip.giu{background:var(--giu-nen);color:var(--giu);border-color:var(--giu-vien)}
.bcs-chip.moi{background:var(--moi-nen);color:var(--moi);border-color:var(--moi-vien)}
.bcs-chip.bo-qua{background:#f0f2f0;color:var(--ink-3);border-color:var(--line)}
.bcs-mo-them{font-size:12.5px;color:var(--primary);font-weight:600;padding:4px 12px;border:1px solid #b7cde0;border-radius:var(--radius);background:#fff}
.bcs-van-ban[open] .bcs-mo-them{display:none}
.bcs-chon{display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--primary);white-space:nowrap;
  border:1px solid #b7cde0;padding:5px 10px;border-radius:var(--radius);background:#f3f7fb;cursor:pointer}
.bcs-bo-qua{display:none;padding:12px 16px;font-size:12.5px;color:var(--ink-3)}
.bcs-du-an.tat{background:#f6f7f5}
.bcs-du-an.tat .bcs-the-than{display:none}
.bcs-du-an.tat .bcs-bo-qua{display:block}
.bcs-du-an.tat .bcs-so-la-ma{background:var(--ink-3)}
.bcs-van-ban-luoi{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:14px 16px}
.bcs-rong-het{grid-column:1/-1}
.bcs-the-than{display:flex;flex-direction:column;gap:12px;padding:16px}

.bcs-o{border:1px solid var(--line-soft);border-left:4px solid var(--line);border-radius:var(--radius);padding:9px 12px 11px;
  background:#fff;transition:border-color .2s,background-color .2s,box-shadow .3s;scroll-margin-top:80px}
.bcs-o.thieu{border-left-color:var(--thieu);background:var(--thieu-nen)}
.bcs-o.giu{border-left-color:var(--giu);background:var(--giu-nen)}
.bcs-o.moi{border-left-color:var(--moi)}
.bcs-o.nhay{box-shadow:0 0 0 3px rgba(31,75,110,.4)}
.bcs-o-dau{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}
.bcs-o-dau label{font-size:13px;font-weight:600;color:var(--ink);display:flex;align-items:center;gap:7px}
.bcs-o-so{width:20px;height:20px;border-radius:50%;background:#e4e9ee;color:var(--ink-2);font-size:11.5px;display:inline-flex;
  align-items:center;justify-content:center;flex:0 0 20px}
.bcs-o .bb{color:var(--thieu)}
.bcs-nhan{font-size:11px;font-weight:600;padding:1px 8px;border-radius:10px;white-space:nowrap}
.bcs-nhan:empty{display:none}
.bcs-o.thieu .bcs-nhan{background:var(--thieu);color:#fff}
.bcs-o.giu .bcs-nhan{background:var(--giu);color:#fff}
.bcs-o.moi .bcs-nhan{background:var(--moi-nen);color:var(--moi);border:1px solid var(--moi-vien)}
.bcs-o textarea,.bcs-o input{width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;
  color:var(--ink);font-size:13.5px;line-height:1.55}
.bcs-o textarea{resize:vertical;overflow:hidden;min-height:64px}
.bcs-o textarea:focus,.bcs-o input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 2px rgba(31,75,110,.15)}
.bcs-o .sai{display:block;color:var(--thieu);font-size:12px;margin-top:4px}
.bcs-truoc{margin-top:6px;font-size:12px}
.bcs-truoc summary{cursor:pointer;color:var(--primary);width:max-content}
.bcs-truoc-noi-dung{white-space:pre-line;margin-top:5px;padding:8px 10px;background:#f4f6f4;border:1px dashed var(--line);
  border-radius:var(--radius);color:var(--ink-2);max-height:260px;overflow:auto;line-height:1.5}
.bcs-goi-y-truoc{font-size:11.5px;color:var(--ink-3);margin-top:4px}
.bcs-tien-do-dong{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.bcs-tien-do-nhap{display:flex;align-items:center;gap:8px}
.bcs-tien-do-nhap input{font-size:22px;font-weight:700;max-width:130px;padding:6px 10px}
.bcs-tien-do-nhap span{font-size:18px;font-weight:600;color:var(--ink-2)}
.bcs-tien-do .tiendo{flex:1;min-width:200px;max-width:560px;height:10px;margin:0}
.bcs-tien-do .bcs-goi-y-truoc{margin:0}
.bcs-nhom{border:1px solid var(--line-soft);border-left:4px solid var(--line);border-radius:var(--radius);padding:9px 12px 11px;background:#fbfcfb}
.bcs-nhom-tieu-de{font-size:13px;font-weight:600;display:flex;align-items:center;gap:7px}
.bcs-don-vi{font-weight:400;color:var(--ink-3);font-size:12px}
.bcs-giai-ngan{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.bcs-o-nho{padding:7px 9px 9px}
.bcs-o-nho .bcs-o-dau{flex-direction:column;align-items:flex-start;gap:3px;margin-bottom:4px}
.bcs-o-nho .bcs-o-dau label{font-size:12px;font-weight:500;color:var(--ink-2)}
.bcs-ti-le{margin:8px 0 0;font-size:12px;color:var(--primary)}
.bcs-ti-le:empty{display:none}
.bcs-chan{position:sticky;bottom:0;z-index:5;display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--surface);
  border-top:1px solid var(--line);box-shadow:0 -4px 12px rgba(23,32,42,.08);flex-wrap:wrap}
.bcs-chan-tom-tat{font-size:13px}
.bcs-gian{flex:1}
@media (max-width:1300px){
  .bcs-van-ban-luoi,.bcs-giai-ngan{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:900px){
  .bcs-than{grid-template-columns:1fr}
  .bcs-nav{position:static;max-height:none;flex-direction:row;overflow-x:auto}
  .bcs-nav-tieu-de,.bcs-chu-giai{display:none}
  .bcs-nav-muc{grid-template-columns:auto auto auto;white-space:nowrap}
  .bcs-tong-quan,.bcs-van-ban-luoi{grid-template-columns:1fr}
  .bcs-the-dau{flex-wrap:wrap}
}

.bc-xem{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:14px;padding:14px;align-items:start;flex:1}
.bc-giay-khung{background:#d9ddd8;border:1px solid var(--line);border-radius:var(--radius);padding:24px;overflow:auto}
.bc-giay{background:#fff;color:#000;max-width:210mm;min-height:297mm;margin:0 auto;padding:20mm 20mm 20mm 30mm;
  box-shadow:0 2px 10px rgba(0,0,0,.18);font-family:"Times New Roman",Times,serif;font-size:13pt;line-height:1.3}
.bc-giay table{min-width:0;width:100%;font-size:inherit;border-collapse:collapse}
.bc-giay td{border:0;padding:0 3px;vertical-align:top;background:transparent}
.bc-giay tbody tr:nth-child(even),.bc-giay tbody tr:hover{background:transparent}
.bc-giay .bc-dau td{text-align:center;font-size:12pt}
.bc-giay .co13{font-size:13pt}
.bc-giay .co12{font-size:12pt}
.bc-giay .co11{font-size:11pt}
.bc-giay .vach{border:0;border-top:1px solid #000;width:32%;margin:4px auto 6px}
.bc-giay .vach.ngan{width:34%}
.bc-giay .vach.dai{width:62%}
.bc-giay h1{font-size:14pt;text-align:center;margin:18pt 0 0}
.bc-giay h2{font-size:14pt;text-align:center;margin:0}
.bc-giay h3{font-size:13pt;margin:9pt 0 3pt;text-align:justify;text-indent:1cm}
.bc-giay p{margin:3pt 0;text-align:justify}
.bc-giay p.than{text-indent:1cm}
.bc-giay p.giua{text-align:center}
.bc-giay p.kinh-gui{margin-left:3.2cm}
.bc-giay p.kinh-gui-dong{margin:0 0 0 4.2cm;text-align:left}
.bc-giay .bc-cuoi .ky{text-align:center}
.bc-ben{display:flex;flex-direction:column;gap:14px;position:sticky;top:14px}
.bc-ben .row{grid-template-columns:100px 1fr}

@media (max-width:1200px){
  .bc-xem{grid-template-columns:1fr}
  .bc-ben{position:static}
}
@media (max-width:900px){
  .bc-giay{padding:12mm;min-height:0}
  .bc-giay-khung{padding:8px}
}
@media print{
  header.bar,.bc-ben,.flash{display:none!important}
  body,.bc-giay-khung{background:#fff}
