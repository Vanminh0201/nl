/* Bản đồ dự án công nghiệp — dùng Leaflet, không cần bước biên dịch */
(function () {
  'use strict';

  var cfg = window.CAU_HINH_BAN_DO || {};
  var duong = window.DUONG_DAN;
  var csrfEl = document.querySelector('meta[name="csrf-token"]');
  var CSRF = csrfEl ? csrfEl.content : '';

  /* ---------- ghi nhớ tuỳ chọn hiển thị ---------- */
  // Lưu trong trình duyệt (localStorage), riêng từng tài khoản — chỉ là tiện ích hiển thị của
  // người xem, không đổi dữ liệu. Trình duyệt chặn lưu trữ (ẩn danh...) thì vẫn chạy, chỉ không nhớ.
  var KHOA_NHO = 'qlda.banDo.' + (window.MA_NGUOI_DUNG || 'khach');
  function docNho() {
    try { return JSON.parse(localStorage.getItem(KHOA_NHO)) || {}; } catch (e) { return {}; }
  }
  function ghiNho(khoa, giaTri) {
    try {
      var o = docNho();
      o[khoa] = giaTri;
      localStorage.setItem(KHOA_NHO, JSON.stringify(o));
    } catch (e) { /* không lưu được thì thôi */ }
  }
  var daNho = docNho();

  // Các ô trong "Cài đặt": đặt lại giá trị đã nhớ trước khi phần dưới đọc chúng để vẽ bản đồ
  var tuyChonNho = daNho.tuyChon || {};
  ['locNen', 'locHienTenDuAn', 'locAnDiem', 'locHienTenDiem', 'locDoDayDuong'].forEach(function (id) {
    var el = document.getElementById(id);
    if (!el) return;
    if (Object.prototype.hasOwnProperty.call(tuyChonNho, id)) {
      var v = tuyChonNho[id];
      if (el.type === 'checkbox') {
        el.checked = !!v;
      } else if (el.tagName !== 'SELECT' || Array.prototype.some.call(el.options, function (o) { return o.value === v; })) {
        el.value = v;
      }
    }
    el.addEventListener('change', function () {
      tuyChonNho[id] = el.type === 'checkbox' ? el.checked : el.value;
      ghiNho('tuyChon', tuyChonNho);
    });
  });

  // Khung Mục lục / Chú giải mở lại đúng như lần trước. Tắt hiệu ứng trượt khi khôi phục để
  // Leaflet đo đúng kích thước bản đồ ngay lúc khởi tạo (ngay bên dưới).
  function khoiPhucKhung(khung, nutMo, mo) {
    if (!khung || !nutMo || typeof mo !== 'boolean') return;
    khung.style.transition = 'none';
    khung.classList.toggle('thu-gon', !mo);
    nutMo.classList.toggle('hien', !mo);
    void khung.offsetWidth;
    khung.style.transition = '';
  }
  khoiPhucKhung(document.getElementById('asideBanDo'), document.getElementById('moKhungBen'), daNho.moMucLuc);
  khoiPhucKhung(document.getElementById('legendBanDo'), document.getElementById('moLegend'), daNho.moChuGiai);

  var nutDatLai = document.getElementById('datLaiTuyChon');
  if (nutDatLai) {
    nutDatLai.addEventListener('click', function () {
      try { localStorage.removeItem(KHOA_NHO); } catch (e) { /* bỏ qua */ }
      location.reload();
    });
  }

  // tolerance: nới vùng bấm/rê chuột quanh đường mảnh vẽ bằng canvas (bấm chọn tuyến để sửa dễ hơn)
  var map = L.map('map', { preferCanvas: true, zoomControl: false, renderer: L.canvas({ tolerance: 4 }) });
  if (cfg.gioi_han && cfg.gioi_han.length === 2) {
    map.fitBounds(cfg.gioi_han);
    // Tỉnh trải dài bắc-nam nhưng màn hình rộng theo chiều ngang, nên fitBounds phải phóng nhỏ
    // hơn mức cần thiết mới vừa hết chiều cao, thừa rất nhiều khoảng trống hai bên (Lào, biển).
    // Phóng thêm 1 cấp cho vừa mắt hơn, chấp nhận có thể hụt chút ít ở mép trên/dưới.
    map.setZoom(map.getZoom() + 1);
  } else {
    map.setView([cfg.vi_do || 17.3, cfg.kinh_do || 106.75], cfg.muc_phong || 8);
  }
  L.control.zoom({ position: 'bottomleft' }).addTo(map);
  // Nút "Vị trí của tôi" (public/js/vi-tri-cua-toi.js)
  if (window.ViTriCuaToi) window.ViTriCuaToi.gan(map, { position: 'bottomleft' });

  /* ---------- lớp nền (đường phố / vệ tinh / địa hình) ---------- */
  // Lưu ý: lớp phủ nhãn địa danh "vệ tinh lai" của Esri (Reference/World_Boundaries_and_Places)
  // đã thử dùng nhưng bị GỠ BỎ — kiểm tra thực tế cho thấy nó vẽ ranh giới/tên tỉnh THEO ĐỊA GIỚI
  // CŨ (còn tách riêng "Quảng Bình"/"Quảng Trị"), sai với địa giới hành chính sau sáp nhập
  // 01/7/2025. Chưa tìm được nguồn dữ liệu nền nào xác nhận đã cập nhật đúng địa giới mới, nên
  // ưu tiên không hiển thị nhãn sai còn hơn hiển thị nhầm — quay lại ảnh vệ tinh thuần, không nhãn.
  var lopNenCfg = cfg.lop_nen || {};
  var lopNenHienTai = null;
  var loiTile = 0;

  function chonLopNen(ma) {
    var c = lopNenCfg[ma];
    if (!c) return;

    if (lopNenHienTai) map.removeLayer(lopNenHienTai);
    loiTile = 0;
    canhBao('');

    lopNenHienTai = L.tileLayer(c.tile, { maxZoom: 18, attribution: c.ghi_nguon })
      .on('tileerror', function () {
        if (++loiTile > 4) canhBao('Không tải được nền bản đồ. Điểm dự án và lưới điện vẫn hiển thị đúng toạ độ.');
      })
      .addTo(map);
    lopNenHienTai.bringToBack();
  }

  chonLopNen(document.getElementById('locNen') ? document.getElementById('locNen').value : 'pho');

  var lopHaTang = L.layerGroup().addTo(map);
  var lopRanhGioi = L.layerGroup().addTo(map);
  var lopDuAn = L.layerGroup().addTo(map);
  // Chi tiết dự án (ranh giới, lô đất, tuyến, trạm… nhập ở trang dự án), bật riêng từng dự án. Pane nằm
  // dưới lưới điện (overlayPane 400) để tuyến điện vẫn thấy rõ trên nền lô đất tô màu.
  map.createPane('chiTietDuAn').style.zIndex = 390;
  var lopChiTiet = L.layerGroup().addTo(map);
  // Nhãn tên dự án: lớp riêng, chỉ gắn lên bản đồ khi bật "Hiện tên dự án" trong Cài đặt
  var lopTenDuAn = L.layerGroup();

  var duAn = [];
  var dangChon = null;
  var hen = null;

  // Ẩn/hiện dự án trên bản đồ (theo từng dự án hoặc cả nhóm loại hình) — lựa chọn riêng của
  // người đang xem (ghi nhớ trong trình duyệt), không đổi dữ liệu, giữ nguyên khi lọc/tìm lại.
  var anDuAn = {};
  (daNho.anDuAn || []).forEach(function (id) { anDuAn[id] = true; });
  // Nhóm loại hình đang thu gọn ở sidebar — giữ khi vẽ lại danh sách và khi mở lại trang
  var nhomDong = {};
  (daNho.nhomDong || []).forEach(function (ma) { nhomDong[ma] = true; });
  // Dự án đang bật "hiện chi tiết" — ghi nhớ như ẩn/hiện dự án. Dữ liệu chỉ tải khi bật, giữ lại để
  // tắt/bật lại không phải tải lần nữa.
  var chiTietBat = {};
  (daNho.chiTiet || []).forEach(function (id) { chiTietBat[id] = true; });
  var chiTietDaTai = {};
  var chiTietDangTai = {};
  var lopTheoDuAn = {};

  function dsKhoaBat(o) {
    return Object.keys(o).filter(function (k) { return o[k]; });
  }

  function canhBao(text) {
    var el = document.getElementById('canhBao');
    el.textContent = text;
    el.style.display = text ? 'block' : 'none';
  }

  function so(n) {
    return n === null || n === undefined || n === '' ? '' : Number(n).toLocaleString('vi-VN', { maximumFractionDigits: 2 });
  }

  function thoatHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function thamSoLoc() {
    return new URLSearchParams({
      tu_khoa: document.getElementById('tuKhoa').value.trim(),
      loai_hinh: document.getElementById('locLoaiHinh').value,
      trang_thai: document.getElementById('locTrangThai').value
    });
  }

  function mauDienAp(kv) {
    if (kv === null || kv === undefined) return '#8a8f94';
    if (kv >= 500) return '#c0392b';
    if (kv >= 220) return '#d97b2a';
    if (kv >= 110) return '#2f6fae';
    if (kv >= 22) return '#6f8390';
    return '#8a8f94';
  }

  // Dự án nguồn điện chưa vận hành vẽ màu nhạt (pha trắng) để phân biệt ngay với nguồn đang phát
  // điện; dự án đã vận hành gắn class "dang-van-hanh" — khi đó cánh quạt điện gió, nước xả qua
  // đập thuỷ điện và nắng chiếu dàn pin điện mặt trời chuyển động (app.css); nguồn chưa vận hành
  // gắn "chua-van-hanh" để làm nhạt cả phần tô màu bên trong biểu tượng (đập, dàn pin).
  var nguonDien = {};
  (cfg.loai_hinh_nguon_dien || []).forEach(function (ma) { nguonDien[ma] = true; });

  function laNguonChuaVanHanh(p) {
    return !!nguonDien[p.loai_hinh_ma] && !dangVanHanh(p);
  }

  function mauDuAn(p) {
    return laNguonChuaVanHanh(p) ? phaTrang(p.mau, 0.5) : p.mau;
  }

  function lopDiem(p) {
    if (dangVanHanh(p)) return 'dang-van-hanh';
    return laNguonChuaVanHanh(p) ? 'chua-van-hanh' : '';
  }

  function phaTrang(hex, tiLe) {
    var h = (hex || '').replace('#', '');
    if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
    if (!/^[0-9a-f]{6}$/i.test(h)) return hex;
    return '#' + [0, 2, 4].map(function (i) {
      var v = parseInt(h.substr(i, 2), 16);
      return ('0' + Math.round(v + (255 - v) * tiLe).toString(16)).slice(-2);
    }).join('');
  }

  /* ---------- dự án ---------- */
  function taiDuAn() {
    document.getElementById('dem').textContent = 'Đang tải…';

    fetch(duong.duAn + '?' + thamSoLoc(), { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (gj) {
        lopDuAn.clearLayers();
        lopRanhGioi.clearLayers();
        lopTenDuAn.clearLayers();
        duAn = [];
        lopTheoDuAn = {};
        var daThem = {};

        gj.features.forEach(function (f) {
          var p = f.properties;

          if (!daThem[p.id]) {
            daThem[p.id] = true;
            duAn.push(p);
            themNhanTen(p, duAn.length);
          }

          // Dự án chưa có toạ độ: server trả geometry null — vẫn hiện trong danh sách bên (đã
          // push ở trên) nhưng không có gì để vẽ lên bản đồ.
          if (! f.geometry) return;

          if (p.vai_tro === 'lop') {
            var lop;
            if (f.geometry.type === 'MultiPoint') {
              // Nhiều điểm gộp chung 1 lớp (VD cột/mốc dọc tuyến): vẽ từng điểm riêng để giữ
              // nhãn/toạ độ chính xác, nhưng cả nhóm vẫn ẩn/hiện cùng nhau vì chung 1 bản ghi.
              lop = L.featureGroup();
              f.geometry.coordinates.forEach(function (c, i) {
                var m = L.marker([c[1], c[0]], { icon: BieuTuongLoaiHinh.divIcon(p.lop_bieu_tuong, mauDuAn(p), 22, lopDiem(p)) });
                var nhan = (p.lop_nhan && p.lop_nhan[i]) || p.lop_ten || p.ten;
                m.bindTooltip(thoatHtml(nhan), { sticky: true });
                m.bindPopup(function () { return bongChuThich(p); });
                m.on('click', function () { chon(p.id, false); });
                m.addTo(lop);
              });
            } else {
              lop = L.geoJSON(f, {
                style: { color: mauDuAn(p), weight: p.lop_loai === 'duong' ? 3 : 2, fillOpacity: p.lop_loai === 'vung' ? 0.18 : 0 },
                pointToLayer: function (feat, ll) {
                  return L.marker(ll, { icon: BieuTuongLoaiHinh.divIcon(p.lop_bieu_tuong, mauDuAn(p), 24, lopDiem(p)) });
                }
              });
              lop.bindTooltip(thoatHtml(p.lop_ten || p.ten), { sticky: true });
              lop.bindPopup(function () { return bongChuThich(p); });
              lop.on('click', function () { chon(p.id, false); });
            }
            lop.duAnId = p.id;
            themLopTheoDuAn(p.id, lop, lopRanhGioi);
            return;
          }

          var m = L.marker([f.geometry.coordinates[1], f.geometry.coordinates[0]], {
            icon: BieuTuongLoaiHinh.divIcon(p.bieu_tuong, mauDuAn(p), 26, lopDiem(p))
          });
          m.duAnId = p.id;
          m.bindTooltip(thoatHtml(p.ten), { direction: 'top', offset: [0, -16] });
          m.bindPopup(function () { return bongChuThich(p); });
          m.on('click', function () { chon(p.id, false); });
          themLopTheoDuAn(p.id, m, lopDuAn);
        });

        veDanhSach();
        tranhChongNhan();
        dongBoChiTiet();
      })
      .catch(function () { document.getElementById('dem').textContent = 'Không tải được dữ liệu dự án.'; });
  }

  function themNhanTen(p, thuTu) {
    if (p.vi_do == null || p.kinh_do == null) return;
    var nhan = L.tooltip({
      // Không đặt permanent thì Leaflet tự đóng nhãn mỗi khi bấm vào bản đồ
      permanent: true,
      direction: 'right',
      // Nhãn đặt sát mép phải huy hiệu (khung chữ nhật của điện mặt trời rộng hơn khung tròn)
      offset: [Math.ceil(BieuTuongLoaiHinh.kichThuocBadge(p.bieu_tuong, 26).w / 2), 0],
      className: 'nhan-du-an' + (dangVanHanh(p) ? ' van-hanh' : '')
    }).setLatLng([p.vi_do, p.kinh_do]).setContent(thoatHtml(p.ten));
    nhan.duAnId = p.id;
    // Dự án đã vận hành được ưu tiên giữ nhãn khi các nhãn chồng lên nhau
    nhan.uuTien = (dangVanHanh(p) ? 0 : 100000) + thuTu;
    themLopTheoDuAn(p.id, nhan, lopTenDuAn);
  }

  // Cụm dự án sát nhau (VD các trang trại điện gió) nếu hiện hết nhãn sẽ đè thành 1 mảng chữ
  // không đọc được: chỉ giữ nhãn không chồng lên nhãn đã đặt trước (theo thứ tự ưu tiên, dự án
  // đang chọn trước hết). Phóng to thì cụm tách ra, nhãn bị ẩn tự hiện lại.
  function tranhChongNhan() {
    if (!map.hasLayer(lopTenDuAn)) { anNhanLuoiTrung([]); return; }
    var ds = [];
    lopTenDuAn.eachLayer(function (t) { ds.push(t); });
    ds.sort(function (a, b) {
      return (a.duAnId === dangChon ? -1 : a.uuTien) - (b.duAnId === dangChon ? -1 : b.uuTien);
    });
    var daDat = [];
    ds.forEach(function (t) {
      var el = t.getElement();
      if (!el) return;
      el.style.visibility = '';
      var r = el.getBoundingClientRect();
      var chong = daDat.some(function (d) {
        return r.left < d.right && r.right > d.left && r.top < d.bottom && r.bottom > d.top;
      });
      if (chong) el.style.visibility = 'hidden'; else daDat.push(r);
    });
    anNhanLuoiTrung(daDat);
  }
  map.on('moveend', function () { requestAnimationFrame(tranhChongNhan); });

  // Nhãn điểm lưới điện (ô "Hiện tên điểm lưới điện") đè lên nhãn dự án — VD trạm biến áp vừa là điểm lưới
  // điện vừa là dự án — thì chỉ giữ nhãn dự án
  function anNhanLuoiTrung(daDat) {
    lopHaTang.eachLayer(function (nhom) {
      if (!nhom.eachLayer) return;
      nhom.eachLayer(function (l) {
        var t = l.getTooltip ? l.getTooltip() : null;
        var el = t && t.options.permanent ? t.getElement() : null;
        if (!el) return;
        el.style.visibility = '';
        var r = el.getBoundingClientRect();
        var chong = daDat.some(function (d) {
          return r.left < d.right + 6 && r.right > d.left - 6 && r.top < d.bottom + 6 && r.bottom > d.top - 6;
        });
        if (chong) el.style.visibility = 'hidden';
      });
    });
  }

  // Ghi lại lớp bản đồ của 1 dự án để sau này ẩn/hiện lại được, và áp ngay trạng thái ẩn đang
  // giữ từ trước (nếu có) — nhờ vậy lọc/tìm lại (gọi lại taiDuAn) không tự làm hiện lại dự án
  // người dùng đã chủ động ẩn.
  function themLopTheoDuAn(id, layer, nhom) {
    if (!lopTheoDuAn[id]) lopTheoDuAn[id] = [];
    lopTheoDuAn[id].push({ layer: layer, nhom: nhom });
    if (!anDuAn[id]) nhom.addLayer(layer);
  }

  function datAnHienDuAn(id, an) {
    anDuAn[id] = an;
    (lopTheoDuAn[id] || []).forEach(function (t) {
      if (an) t.nhom.removeLayer(t.layer); else t.nhom.addLayer(t.layer);
    });
    ghiNho('anDuAn', dsKhoaBat(anDuAn).map(Number));
    apChiTiet(id, false);
    tranhChongNhan();
  }

  function bongChuThich(p) {
    var d = ['<b>' + thoatHtml(p.ten) + '</b>'];
    if (p.chu_dau_tu) d.push(thoatHtml(p.chu_dau_tu));
    d.push(thoatHtml(p.loai_hinh) + ' — ' + thoatHtml(p.trang_thai));
    if (p.von) d.push('Vốn: ' + so(p.von) + ' tỷ đồng');
    // Dự án ngoài phạm vi hồ sơ của tài khoản (chủ đầu tư chưa được "Xem tất cả dự án") chỉ xem trên bản đồ
    var lienKet = [];
    if (p.xem_chi_tiet !== false) lienKet.push('<a href="' + thoatHtml(p.url) + '">Xem hồ sơ dự án</a>');
    if (coChiTiet(p)) {
      lienKet.push('<a href="#" data-chi-tiet-popup="' + p.id + '">'
        + (chiTietBat[p.id] ? 'Ẩn chi tiết trên bản đồ' : 'Hiện chi tiết trên bản đồ') + '</a>');
    }
    if (lienKet.length) d.push(lienKet.join(' · '));
    return d.join('<br>');
  }

  // Gom dự án theo loại hình (mã ổn định, không đổi khi sửa tên hiển thị) — giữ đúng thứ tự
  // loại hình xuất hiện lần đầu trong danh sách server trả về, không tự sắp xếp lại theo tên.
  function gomDuAnTheoLoaiHinh() {
    var nhom = {}, thuTu = [];
    duAn.forEach(function (p) {
      var ma = p.loai_hinh_ma || '_khac';
      if (!nhom[ma]) {
        nhom[ma] = { ten: p.loai_hinh || 'Khác', mau: p.mau, ds: [], tongMw: 0 };
        thuTu.push(ma);
      }
      nhom[ma].ds.push(p);
      if (p.cong_suat) nhom[ma].tongMw += Number(p.cong_suat) || 0;
    });
    // Dự án đã đi vào hoạt động xếp lên đầu mỗi nhóm — nổi bật, dễ phân biệt với các dự án
    // còn ở giai đoạn quy hoạch/nghiên cứu (đa số). Trong cùng 1 nhóm trạng thái thì giữ
    // nguyên thứ tự gốc (sort ổn định) thay vì xáo trộn thêm.
    Object.keys(nhom).forEach(function (ma) {
      nhom[ma].ds = nhom[ma].ds
        .map(function (p, i) { return { p: p, i: i }; })
        .sort(function (a, b) {
          var x = dangVanHanh(a.p) ? 0 : 1, y = dangVanHanh(b.p) ? 0 : 1;
          return x - y || a.i - b.i;
        })
        .map(function (o) { return o.p; });
    });
    return { nhom: nhom, thuTu: thuTu };
  }

  function dangVanHanh(p) {
    return p.trang_thai === 'Đã đi vào hoạt động';
  }

  // Đổi màu hex (VD "#7a60fb") sang rgba nhạt để tô nền tiêu đề nhóm — dễ phân biệt loại hình
  // ngay khi lướt mắt qua sidebar, mà chữ vẫn đọc được (không dùng màu gốc đậm làm nền).
  function hexSangNenNhat(hex, do_dam) {
    var h = (hex || '').replace('#', '');
    if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
    var r = parseInt(h.substr(0, 2), 16), gg = parseInt(h.substr(2, 2), 16), b = parseInt(h.substr(4, 2), 16);
    if (isNaN(r) || isNaN(gg) || isNaN(b)) return '';
    return 'rgba(' + r + ',' + gg + ',' + b + ',' + do_dam + ')';
  }

  function veDanhSach() {
    var soChuaToaDo = duAn.filter(function (p) { return p.vi_do == null; }).length;
    document.getElementById('dem').textContent = duAn.length + ' dự án'
      + (soChuaToaDo ? ' (' + soChuaToaDo + ' chưa có toạ độ)' : '');
    var box = document.getElementById('danhSach');

    if (!duAn.length) {
      box.innerHTML = '<div class="trong">Không có dự án nào khớp điều kiện lọc, hoặc các dự án khớp chưa được gắn toạ độ.</div>';
      return;
    }

    var g = gomDuAnTheoLoaiHinh();

    box.innerHTML = g.thuTu.map(function (ma) {
      var nh = g.nhom[ma];
      var caNhomDangHien = nh.ds.some(function (p) { return !anDuAn[p.id]; });
      var hang = nh.ds.map(function (p) {
        var an = !! anDuAn[p.id];
        var vanHanh = dangVanHanh(p);
        var chuaToaDo = p.vi_do == null;
        return '<div class="muc' + (p.id === dangChon ? ' chon' : '') + (an ? ' an' : '') + '"'
          + ' data-id="' + p.id + '" style="--c:' + p.mau + '">'
          + '<div class="vach"></div><div>'
          + '<h3' + (vanHanh ? ' style="color:var(--danger)"' : '') + '>' + thoatHtml(p.ten)
          + (vanHanh ? ' <span class="cham-van-hanh" title="Đã đi vào hoạt động">●</span>' : '') + '</h3>'
          + '<p>' + thoatHtml(p.chu_dau_tu || 'Chưa rõ chủ đầu tư')
          + (p.cong_suat ? ' · ' + so(p.cong_suat) + ' MW' : '') + '</p>'
          + (chuaToaDo ? '<p class="nhan-chua-toa-do">Chưa có toạ độ</p>' : '')
          + '</div><span class="muc-nut">' + nutChiTiet(p) + nutMatDuAn(!an, 'data-du-an-id="' + p.id + '"') + '</span></div>';
      }).join('');
      return '<div class="htnhom' + (nhomDong[ma] ? '' : ' mo') + '" data-khoa="' + thoatHtml(ma) + '">'
        + '<div class="htnhom-hd" style="background:' + hexSangNenNhat(nh.mau, 0.16) + ';border-left:3px solid ' + nh.mau + '">'
        + '<span class="mui">▶</span>' + thoatHtml(nh.ten) + ' (' + nh.ds.length + (nh.tongMw ? ', ' + so(nh.tongMw) + ' MW' : '') + ')'
        + nutMatDuAn(caNhomDangHien, 'data-nhom-loai-hinh="' + thoatHtml(ma) + '"') + '</div>'
        + '<div class="htnhom-body">' + hang + '</div></div>';
    }).join('');

    Array.prototype.forEach.call(box.querySelectorAll('.htnhom-hd'), function (el) {
      el.addEventListener('click', function (e) {
        if (e.target.closest('.ht-mat')) return;
        var dong = !el.parentElement.classList.toggle('mo');
        nhomDong[el.parentElement.dataset.khoa] = dong;
        ghiNho('nhomDong', dsKhoaBat(nhomDong));
      });
    });
    Array.prototype.forEach.call(box.querySelectorAll('.muc'), function (el) {
      el.addEventListener('click', function (e) {
        if (e.target.closest('.ht-mat')) return;
        chon(Number(el.dataset.id), true);
      });
    });
    Array.prototype.forEach.call(box.querySelectorAll('.ht-mat[data-du-an-id]'), function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        datAnHienDuAn(Number(btn.dataset.duAnId), ! btn.classList.contains('dang-an'));
        veDanhSach();
      });
    });
    Array.prototype.forEach.call(box.querySelectorAll('.ht-chi-tiet[data-chi-tiet-id]'), function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        batTatChiTiet(Number(btn.dataset.chiTietId));
      });
    });
    Array.prototype.forEach.call(box.querySelectorAll('.ht-mat[data-nhom-loai-hinh]'), function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var muonHien = btn.classList.contains('dang-an');
        (g.nhom[btn.dataset.nhomLoaiHinh].ds || []).forEach(function (p) { datAnHienDuAn(p.id, ! muonHien); });
        veDanhSach();
      });
    });
  }

  function chon(id, bay) {
    dangChon = id;
    veDanhSach();
    tranhChongNhan();

    var timDuoc = false;
    lopDuAn.eachLayer(function (l) {
      if (l.duAnId !== id) return;
      timDuoc = true;
      l.openPopup();
      if (bay) map.setView(l.getLatLng(), Math.max(map.getZoom(), 13));
    });
    if (timDuoc) return;

    // Dự án không có chấm điểm riêng (đã có lớp đường/vùng thay thế): mở bằng lớp đó
    var lopKhop = [];
    lopRanhGioi.eachLayer(function (l) { if (l.duAnId === id) lopKhop.push(l); });
    if (!lopKhop.length) return;

    // Lớp nhóm điểm (MultiPoint) không tự có popup riêng, mở bằng lớp đầu tiên có popup thật
    var coPopup = lopKhop.find(function (l) { return typeof l.getPopup === 'function' && l.getPopup(); }) || lopKhop[0];
    if (typeof coPopup.openPopup === 'function') coPopup.openPopup();
    if (bay) {
      var gioiHan = lopKhop[0].getBounds();
      lopKhop.slice(1).forEach(function (l) { gioiHan.extend(l.getBounds()); });
      map.fitBounds(gioiHan, { padding: [30, 30] });
    }
  }

  /* ---------- lưới điện ---------- */
  function suaViTriDangBat() {
    var el = document.getElementById('locSuaViTri');
    return !! (el && el.checked);
  }

  // Kéo-thả xong (thả tay ra) là lưu luôn vị trí mới — không cần bấm thêm nút xác nhận, vì đang ở
  // hẳn "chế độ sửa vị trí" riêng (phải bật tick mới kéo được) nên không sợ nhầm với thao tác khác.
  function ganKeoThaViTri(m, f) {
    m.on('dragstart', function () { m.closeTooltip(); });
    m.on('dragend', function () {
      var ll = m.getLatLng();
      var toaDoCu = f.geometry.coordinates.slice();
      fetch(duong.suaViTri.replace('__ID__', f.properties.id), {
        method: 'PATCH',
        headers: { 'X-CSRF-TOKEN': CSRF, Accept: 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ vi_do: ll.lat, kinh_do: ll.lng })
      })
        .then(function (r) { if (!r.ok) throw new Error('loi'); return r.json(); })
        .then(function () {
          f.geometry.coordinates = [ll.lng, ll.lat];
          canhBao((f.properties.ten || 'Điểm') + ': đã lưu vị trí mới.');
        })
        .catch(function () {
          m.setLatLng([toaDoCu[1], toaDoCu[0]]); // Lưu lỗi thì trả điểm về đúng chỗ cũ
          canhBao('Không lưu được vị trí mới, đã trả điểm về chỗ cũ.');
        });
    });
  }

  /* ---------- sửa hình dạng tuyến đường dây (chỉ quản trị, khi bật "Sửa vị trí điểm và tuyến") ---------- */
  // Bấm vào 1 tuyến là hiện nút vuông ở từng đỉnh: kéo để dời đỉnh, kéo chấm tròn giữa 2 đỉnh để
  // thêm đỉnh, nháy đúp/chuột phải vào đỉnh để xoá. Khác kéo điểm TBA (thả là lưu), tuyến có nhiều
  // thao tác liên tiếp nên chỉ ghi khi bấm "Lưu tuyến". Đỉnh thả gần TBA, đầu tuyến khác hoặc điểm
  // dự án thì tự bắt dính đúng toạ độ đó — tránh tuyến bị hụt đầu trạm (giữ Alt để tắt bắt dính).
  var BAN_KINH_BAT = 14; // px
  var lopSuaTuyen = L.layerGroup().addTo(map);
  var suaTuyen = null;
  var doiTuongKhung = [];
  var thanhSuaTuyen = null;

  function suaTuyenDuoc(f) {
    return suaViTriDangBat() && duong.suaHinhHoc && f.properties.id && f.geometry
      && (f.geometry.type === 'LineString' || f.geometry.type === 'MultiLineString');
  }

  function batDauSuaTuyen(f) {
    if (suaTuyen) {
      if (suaTuyen.id === f.properties.id) return;
      if (suaTuyen.daDoi && !confirm('Tuyến đang sửa chưa lưu. Bỏ các thay đổi đó?')) return;
      ketThucSuaTuyen(false);
    }
    var g = f.geometry, laMulti = g.type === 'MultiLineString';
    suaTuyen = {
      id: f.properties.id, laMulti: laMulti, daDoi: false, lichSu: [],
      mau: f.properties.mau || mauDienAp(f.properties.kv),
      ten: f.properties.lop_ten || f.properties.ten || 'Đường dây',
      phan: (laMulti ? g.coordinates : [g.coordinates]).map(function (ds) {
        return ds.map(function (c) { return L.latLng(c[1], c[0]); });
      })
    };
    map.closePopup();
    // Ẩn bản gốc đang vẽ ở lớp lưới điện — chỉ còn bản đang sửa
    lopHaTang.eachLayer(function (nhom) {
      if (!nhom.eachLayer) return;
      nhom.eachLayer(function (l) { if (l.feature && l.feature.properties.id === suaTuyen.id) nhom.removeLayer(l); });
    });
    hienThanhSuaTuyen();
    veLaiSuaTuyen();
  }

  function ketThucSuaTuyen(taiLai) {
    suaTuyen = null;
    lopSuaTuyen.clearLayers();
    if (thanhSuaTuyen) thanhSuaTuyen.style.display = 'none';
    if (taiLai !== false) taiHaTang();
  }

  function luuBuoc() {
    suaTuyen.lichSu.push(suaTuyen.phan.map(function (ds) { return ds.map(function (ll) { return L.latLng(ll.lat, ll.lng); }); }));
    if (suaTuyen.lichSu.length > 50) suaTuyen.lichSu.shift();
    suaTuyen.daDoi = true;
    capNhatThanhSuaTuyen();
  }

  function hoanTacSuaTuyen() {
    if (!suaTuyen || !suaTuyen.lichSu.length) return;
    suaTuyen.phan = suaTuyen.lichSu.pop();
    suaTuyen.daDoi = suaTuyen.lichSu.length > 0;
    veLaiSuaTuyen();
    capNhatThanhSuaTuyen();
  }

  function timDiemBat(ll) {
    var p = map.latLngToContainerPoint(ll), tot = null, kc = BAN_KINH_BAT;
    function thu(lng, lat) {
      var d = p.distanceTo(map.latLngToContainerPoint([lat, lng]));
      if (d < kc) { kc = d; tot = L.latLng(lat, lng); }
    }
    doiTuongKhung.forEach(function (f) {
      var g = f.geometry;
      if (!g || f.properties.id === suaTuyen.id) return;
      if (g.type === 'Point') thu(g.coordinates[0], g.coordinates[1]);
      else if (g.type === 'MultiPoint') g.coordinates.forEach(function (c) { thu(c[0], c[1]); });
      else if (g.type === 'LineString' || g.type === 'MultiLineString') {
        (g.type === 'LineString' ? [g.coordinates] : g.coordinates).forEach(function (ds) {
          if (!ds.length) return;
          thu(ds[0][0], ds[0][1]);
          thu(ds[ds.length - 1][0], ds[ds.length - 1][1]);
        });
      }
    });
    duAn.forEach(function (d) { if (d.vi_do != null && d.kinh_do != null) thu(d.kinh_do, d.vi_do); });
    return tot;
  }

  function veLaiSuaTuyen() {
    lopSuaTuyen.clearLayers();
    if (!suaTuyen) return;
    var s = suaTuyen;

    s.phan.forEach(function (ds) {
      L.polyline(ds, { color: '#ffd400', weight: 9, opacity: 0.55, interactive: false }).addTo(lopSuaTuyen);
      var duongVe = L.polyline(ds, { color: s.mau, weight: 3.5, opacity: 1, interactive: false }).addTo(lopSuaTuyen);

      // Chấm tròn giữa 2 đỉnh: kéo ra để chèn đỉnh mới. Đoạn quá ngắn trên màn hình thì bỏ cho đỡ rối.
      ds.slice(0, -1).forEach(function (dau, i) {
        var a = map.latLngToContainerPoint(ds[i]), b = map.latLngToContainerPoint(ds[i + 1]);
        if (a.distanceTo(b) < 28) return;
        var giua = L.latLng((ds[i].lat + ds[i + 1].lat) / 2, (ds[i].lng + ds[i + 1].lng) / 2);
        var m = L.marker(giua, { icon: L.divIcon({ className: 'dinh-giua', iconSize: [10, 10] }), draggable: true, zIndexOffset: 900 })
          .bindTooltip('Kéo để thêm đỉnh', { direction: 'top' });
        m.on('dragstart', function () { m.closeTooltip(); luuBuoc(); ds.splice(i + 1, 0, m.getLatLng()); });
        m.on('drag', function (e) {
          var bat = !(e.originalEvent && e.originalEvent.altKey) && timDiemBat(m.getLatLng());
          if (bat) m.setLatLng(bat);
          ds[i + 1] = m.getLatLng();
          duongVe.setLatLngs(ds);
        });
        m.on('dragend', veLaiSuaTuyen);
        m.addTo(lopSuaTuyen);
      });

      ds.forEach(function (ll, i) {
        var dauCuoi = i === 0 || i === ds.length - 1;
        var m = L.marker(ll, {
          icon: L.divIcon({ className: 'dinh-tuyen' + (dauCuoi ? ' dau-cuoi' : ''), iconSize: [12, 12] }),
          draggable: true, zIndexOffset: 1000
        }).bindTooltip((dauCuoi ? 'Đầu tuyến' : 'Đỉnh ' + (i + 1)) + ' — kéo để dời, nháy đúp để xoá', { direction: 'top' });
        m.on('dragstart', function () { m.closeTooltip(); luuBuoc(); });
        m.on('drag', function (e) {
          var bat = !(e.originalEvent && e.originalEvent.altKey) && timDiemBat(m.getLatLng());
          if (bat) m.setLatLng(bat);
          var el = m.getElement();
          if (el) el.classList.toggle('dinh-bat', !!bat);
          ds[i] = m.getLatLng();
          duongVe.setLatLngs(ds);
        });
        m.on('dragend', veLaiSuaTuyen);
        var xoa = function (e) {
          if (e.originalEvent) L.DomEvent.preventDefault(e.originalEvent);
          if (ds.length <= 2) { canhBao('Mỗi đoạn tuyến phải còn ít nhất 2 đỉnh.'); return; }
          luuBuoc();
          ds.splice(i, 1);
          veLaiSuaTuyen();
        };
        m.on('dblclick', xoa);
        m.on('contextmenu', xoa);
        m.addTo(lopSuaTuyen);
      });
    });
  }

  function hienThanhSuaTuyen() {
    if (!thanhSuaTuyen) {
      thanhSuaTuyen = document.createElement('div');
      thanhSuaTuyen.className = 'thanh-sua-tuyen';
      thanhSuaTuyen.innerHTML = '<div class="tst-ten"></div>'
        + '<div class="tst-hd">Kéo ô vuông để dời đỉnh · kéo chấm tròn để thêm đỉnh · nháy đúp (hoặc chuột phải) vào đỉnh để xoá. '
        + 'Đỉnh thả gần TBA, đầu tuyến khác hay điểm dự án sẽ tự bắt dính (giữ Alt để tắt).</div>'
        + '<div class="tst-nut">'
        + '<button type="button" class="btn sm" data-lenh="hoan-tac">↶ Hoàn tác</button>'
        + '<button type="button" class="btn sm" data-lenh="huy">Huỷ</button>'
        + '<button type="button" class="btn sm primary" data-lenh="luu">Lưu tuyến</button></div>';
      L.DomEvent.disableClickPropagation(thanhSuaTuyen);
      L.DomEvent.disableScrollPropagation(thanhSuaTuyen);
      thanhSuaTuyen.addEventListener('click', function (e) {
        var nut = e.target.closest('[data-lenh]');
        if (!nut || !suaTuyen) return;
        if (nut.dataset.lenh === 'hoan-tac') hoanTacSuaTuyen();
        else if (nut.dataset.lenh === 'huy') huySuaTuyen();
        else luuSuaTuyen(nut);
      });
      document.querySelector('.mapwrap').appendChild(thanhSuaTuyen);
    }
    thanhSuaTuyen.style.display = '';
    capNhatThanhSuaTuyen();
  }

  function capNhatThanhSuaTuyen() {
    if (!thanhSuaTuyen || !suaTuyen) return;
    var soDinh = suaTuyen.phan.reduce(function (t, ds) { return t + ds.length; }, 0);
    thanhSuaTuyen.querySelector('.tst-ten').innerHTML = 'Đang sửa: <b>' + thoatHtml(suaTuyen.ten) + '</b> · ' + soDinh + ' đỉnh'
      + (suaTuyen.daDoi ? ' · <span class="tst-chua-luu">chưa lưu</span>' : '');
    thanhSuaTuyen.querySelector('[data-lenh="hoan-tac"]').disabled = !suaTuyen.lichSu.length;
  }

  function huySuaTuyen() {
    if (suaTuyen && suaTuyen.daDoi && !confirm('Bỏ các thay đổi chưa lưu của tuyến này?')) return false;
    ketThucSuaTuyen();
    return true;
  }

  function luuSuaTuyen(nut) {
    var s = suaTuyen;
    var toaDo = s.phan.map(function (ds) {
      return ds.map(function (ll) { return [Math.round(ll.lng * 1e7) / 1e7, Math.round(ll.lat * 1e7) / 1e7]; });
    });
    nut.disabled = true;
    fetch(duong.suaHinhHoc.replace('__ID__', s.id), {
      method: 'PATCH',
      headers: { 'X-CSRF-TOKEN': CSRF, Accept: 'application/json', 'Content-Type': 'application/json' },
      body: JSON.stringify({ coordinates: s.laMulti ? toaDo : toaDo[0] })
    })
      .then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (j) {
          if (!r.ok) throw new Error(j.loi || j.message || 'lỗi máy chủ');
        });
      })
      .then(function () {
        nut.disabled = false;
        canhBao(s.ten + ': đã lưu hình dạng tuyến mới.');
        ketThucSuaTuyen();
        if (duLieuHaTang) lamMoiCayHaTang();
      })
      .catch(function (e) {
        nut.disabled = false;
        canhBao('Không lưu được tuyến: ' + e.message);
      });
  }

  map.on('zoomend', function () { if (suaTuyen) veLaiSuaTuyen(); });
  document.addEventListener('keydown', function (e) {
    if (!suaTuyen || /INPUT|TEXTAREA|SELECT/.test(e.target.tagName)) return;
    if (e.key === 'Escape') huySuaTuyen();
    else if ((e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z')) { e.preventDefault(); hoanTacSuaTuyen(); }
  });
  window.addEventListener('beforeunload', function (e) {
    if (suaTuyen && suaTuyen.daDoi) { e.preventDefault(); e.returnValue = ''; }
  });

  function taiHaTang() {
    lopHaTang.clearLayers();
    canhBao('');

    var locKvEl = document.getElementById('locKv');
    if ((locKvEl && locKvEl.value === '-1') || map.getZoom() < 7) return;

    var b = map.getBounds();
    var bbox = [b.getWest(), b.getSouth(), b.getEast(), b.getNorth()].map(function (v) { return v.toFixed(5); }).join(',');

    function doDayDuong(f) {
      var doDayEl = document.getElementById('locDoDayDuong');
      var doDayTuyChon = doDayEl && doDayEl.value ? parseFloat(doDayEl.value) : null;
      return doDayTuyChon || f.properties.kich_thuoc || (f.properties.kv >= 220 ? 2.4 : 1.6);
    }

    fetch(duong.haTang + '?bbox=' + bbox, { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (gj) {
        doiTuongKhung = gj.features || [];
        // Tuyến đang sửa đã vẽ riêng ở lopSuaTuyen, bỏ bản gốc khỏi lớp lưới điện
        var dangSuaId = suaTuyen ? suaTuyen.id : null;
        // Viền trắng vẽ trước, rộng hơn đường thật — giúp màu đường (nhất là đỏ/cam) nổi rõ
        // trên mọi nền, kể cả ảnh vệ tinh nhiều màu. Chỉ áp cho đường, không áp cho điểm/vùng.
        L.geoJSON(gj, {
          filter: function (f) {
            return (f.geometry.type === 'LineString' || f.geometry.type === 'MultiLineString') && f.properties.id !== dangSuaId;
          },
          style: function (f) {
            return {
              color: '#ffffff', weight: doDayDuong(f) + 2.5,
              opacity: f.properties.quy_hoach ? 0.45 : 0.75,
            };
          },
          // Viền rộng hơn đường thật nên dùng luôn làm vùng bấm chọn tuyến khi đang ở chế độ sửa
          onEachFeature: function (f, layer) {
            if (suaTuyenDuoc(f)) layer.on('click', function (e) { L.DomEvent.stop(e); batDauSuaTuyen(f); });
          }
        }).addTo(lopHaTang);

        L.geoJSON(gj, {
          // Ô "Ẩn điểm cột" ở thanh công cụ ẩn điểm cột/tháp của đường dây trên mọi lớp cùng lúc,
          // TBA (trạm biến áp) và nhà máy điện luôn giữ hiện vì là mốc quan trọng cần thấy — chỉ ẩn hiển thị, dữ
          // liệu và trạng thái bật/tắt từng lớp không đổi.
          filter: function (f) {
            if (f.properties.id === dangSuaId) return false;
            var anDiemEl = document.getElementById('locAnDiem');
            if (! (anDiemEl && anDiemEl.checked)) return true;
            var laDiem = f.geometry.type === 'Point' || f.geometry.type === 'MultiPoint';
            return ! laDiem || f.properties.loai === 'tram' || f.properties.loai === 'nha_may';
          },
          // Màu/kích thước riêng đặt trên lớp (lop_ha_tang) ghi đè mặc định theo cấp điện áp
          // khi có — để trống thì giữ nguyên quy ước tô theo kV như trước giờ. Độ dày chọn ở
          // thanh công cụ bản đồ (nếu có) ghi đè lên trên cùng, áp cho mọi đường đang xem.
          style: function (f) {
            var kv = f.properties.kv, c = f.properties.mau || mauDienAp(kv);
            var w = doDayDuong(f);
            // Quy hoạch (chưa xây): vẽ nét đứt, mờ hơn hiện trạng để phân biệt ngay trên bản đồ
            return f.properties.quy_hoach
              ? { color: c, weight: w, opacity: 0.7, fillColor: c, fillOpacity: 0.1, dashArray: '7,5' }
              : { color: c, weight: w, opacity: 1, fillColor: c, fillOpacity: 0.22 };
          },
          pointToLayer: function (f, ll) {
            var mau = f.properties.mau || mauDienAp(f.properties.kv);
            var quyHoach = f.properties.quy_hoach;
            if (f.properties.bieu_tuong) {
              var icon = BieuTuongLoaiHinh.divIcon(f.properties.bieu_tuong, mau, f.properties.kich_thuoc || 22);
              // Chỉ kéo-thả được điểm đơn (Point) — điểm gộp (MultiPoint, VD cột dọc tuyến) 1 bản
              // ghi ứng với nhiều toạ độ, kéo 1 điểm hiện trên bản đồ không rõ sửa đúng toạ độ nào.
              var keoThaDuoc = suaViTriDangBat() && f.geometry.type === 'Point' && duong.suaViTri && f.properties.id;
              var m = L.marker(ll, { icon: icon, opacity: quyHoach ? 0.55 : 1, draggable: !! keoThaDuoc });
              if (keoThaDuoc) ganKeoThaViTri(m, f);
              return m;
            }
            return L.circleMarker(ll, {
              radius: f.properties.kich_thuoc || (f.properties.loai === 'tram' ? 5 : 3.5),
              color: '#fff', weight: 1,
              fillColor: mau, fillOpacity: quyHoach ? 0.4 : 0.95,
              dashArray: quyHoach ? '3,2' : null
            });
          },
          onEachFeature: function (f, layer) {
            var p = f.properties, d = [], ct = p.chi_tiet || {};
            // Tên riêng của đối tượng đường đọc từ file gốc thường chung chung (VD "Đường dây") — khi đó
            // dùng tên lớp (đã bỏ hậu tố tách loại) cho rõ tuyến nào. Tuyến đã đặt tên riêng đủ rõ (VD các
            // tuyến quy hoạch đặt theo mục đích) thì hiện tên riêng, kèm tên lớp ở dòng dưới.
            var laDuong = f.geometry && (f.geometry.type === 'LineString' || f.geometry.type === 'MultiLineString');
            var tenRieng = !! p.ten && p.ten.length > 12 && p.ten !== p.lop_ten && ! /^Đường dây$/i.test(p.ten);
            var nhan = laDuong ? (tenRieng ? p.ten : (p.lop_ten || p.ten)) : p.ten;
            if (nhan) d.push('<b>' + thoatHtml(nhan) + '</b>' + (p.quy_hoach ? ' <i>(Quy hoạch)</i>' : ''));
            if (laDuong && tenRieng && p.lop_ten) d.push('<span style="color:#667">Thuộc: ' + thoatHtml(p.lop_ten) + '</span>');
            var quyMo = [p.kv ? p.kv + ' kV' : '', ct.so_mach ? ct.so_mach + ' mạch' : '', ct.day_dan || '',
              ct.chieu_dai_km ? so(ct.chieu_dai_km) + ' km' : '', ct.cap_dien_ap || '', ct.mba ? 'MBA ' + ct.mba : ''].filter(Boolean);
            if (quyMo.length) d.push(thoatHtml(quyMo.join(' · ')));
            if (ct.muc_dich) d.push('<b>Mục đích:</b> ' + thoatHtml(ct.muc_dich));
            if (ct.cong_suat_mw) d.push('Công suất truyền tải: ' + so(ct.cong_suat_mw) + ' MW'
              + (ct.mang_tai_n1_phan_tram ? ' · mang tải khi mất 1 mạch khoảng ' + ct.mang_tai_n1_phan_tram + '%' : ''));
            if (ct.can_cu) d.push('Căn cứ: ' + thoatHtml(ct.can_cu));
            if (ct.ghi_chu) d.push('<i>' + thoatHtml(ct.ghi_chu) + '</i>');
            // Chế độ sửa: bấm vào tuyến là mở chỉnh sửa hình dạng thay cho popup thông tin
            if (suaTuyenDuoc(f)) {
              layer.on('click', function (e) { L.DomEvent.stop(e); batDauSuaTuyen(f); });
              if (nhan) nhan += ' — bấm để sửa tuyến';
            } else if (d.length) layer.bindPopup(d.join('<br>'), { maxWidth: 380 });
            // Di chuột qua hiện tên ngay (không cần bấm) — chỉ đối tượng có tên mới có tooltip.
            // Bật ô "Hiện tên điểm" ở thanh công cụ thì tên điểm hiện luôn, không cần rê chuột
            // (chỉ áp cho điểm — hiện thường trực tên mọi đoạn đường sẽ rối bản đồ).
            var laDiemFt = f.geometry && (f.geometry.type === 'Point' || f.geometry.type === 'MultiPoint');
            var hienLuon = laDiemFt && document.getElementById('locHienTenDiem')
              && document.getElementById('locHienTenDiem').checked;
            if (nhan) layer.bindTooltip(thoatHtml(nhan), { direction: 'top', sticky: true, permanent: !! hienLuon, className: 'nhan-ha-tang' });
          }
        }).addTo(lopHaTang);

        requestAnimationFrame(tranhChongNhan);
        if (gj.bi_cat) canhBao('Khung nhìn có quá nhiều đối tượng nên chỉ hiển thị phần cấp điện áp cao nhất. Phóng to để xem đầy đủ.');
      })
      .catch(function () { canhBao('Không tải được lớp lưới điện.'); });
  }

  /* ---------- menu "Lưới điện": thống kê tuyến ĐZ/TBA theo cấp điện áp, bấm vào là bay tới ---------- */
  var duLieuHaTang = null;

  function taiThongKeHaTang() {
    if (duLieuHaTang || ! duong.thongKeHaTang) return;
    document.getElementById('demHaTang').textContent = 'Đang tải…';

    fetch(duong.thongKeHaTang, { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (ds) {
        duLieuHaTang = ds;
        veCayHaTang(ds);
      })
      .catch(function () { document.getElementById('demHaTang').textContent = 'Không tải được số liệu.'; });
  }

  // Tai lai so lieu lop ha tang tu server (sau khi an/hien) va ve lai cay, nhung giu nguyen
  // cac nhanh (cap dien ap / nhom) ma nguoi dung dang mo truoc do — tranh cay tu dong cup lai.
  function lamMoiCayHaTang() {
    if (! duong.thongKeHaTang) return;
    var box = document.getElementById('dsHaTang');
    var dangMo = {};
    Array.prototype.forEach.call(box.querySelectorAll('.httier.mo, .htnhom.mo'), function (el) {
      if (el.dataset.khoa) dangMo[el.dataset.khoa] = true;
    });

    fetch(duong.thongKeHaTang, { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (ds) {
        duLieuHaTang = ds;
        veCayHaTang(ds);
        Array.prototype.forEach.call(box.querySelectorAll('.httier, .htnhom'), function (el) {
          if (el.dataset.khoa && dangMo[el.dataset.khoa]) el.classList.add('mo');
        });
      })
      .catch(function () { canhBao('Không tải lại được danh sách lớp.'); });
  }

  var SVG_MAT_MO = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>';
  var SVG_MAT_DONG = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/><line x1="3" y1="3" x2="21" y2="21"/></svg>';

  // Nút con mắt ẩn/hiện lớp trên bản đồ — chỉ hiện với tài khoản có quyền sửa (quan_tri/nhập liệu),
  // gọi thẳng API bật/tắt "hien_thi" sẵn có của trang Lớp hạ tầng (patch từng lop_id trong nhóm).
  function nutMat(hienThi, lopId) {
    if (!duong.anHienLop || !lopId || !lopId.length) return '';
    return '<button type="button" class="ht-mat' + (hienThi ? '' : ' dang-an') + '" data-lop-id=\'' + JSON.stringify(lopId) + '\''
      + ' title="' + (hienThi ? 'Đang hiện trên bản đồ — bấm để ẩn' : 'Đang ẩn trên bản đồ — bấm để hiện') + '">'
      + (hienThi ? SVG_MAT_MO : SVG_MAT_DONG) + '</button>';
  }

  // Nút con mắt ẩn/hiện DỰ ÁN trên bản đồ — khác nút lưới điện ở trên: đây chỉ là lựa chọn xem
  // tạm thời phía trình duyệt (không có cột "hien_thi" nào cho dự án), nên ai cũng bấm được,
  // không cần gọi server.
  function nutMatDuAn(hienThi, thuocTinh) {
    return '<button type="button" class="ht-mat' + (hienThi ? '' : ' dang-an') + '" ' + thuocTinh
      + ' title="' + (hienThi ? 'Đang hiện trên bản đồ — bấm để ẩn' : 'Đang ẩn trên bản đồ — bấm để hiện') + '">'
      + (hienThi ? SVG_MAT_MO : SVG_MAT_DONG) + '</button>';
  }

  /* ---------- chi tiết từng dự án trên bản đồ chung ---------- */
  var SVG_LOP = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>';
  // Nhóm đường/vùng chưa đặt màu riêng lấy lần lượt trong bảng màu — cùng bảng với bản đồ trang dự án
  var BANG_MAU_CHI_TIET = ['#ffd23f', '#35d0ff', '#ff5d8f', '#7cfc5a', '#ff9f1c', '#c084fc', '#00e5b0', '#ffffff'];

  function coChiTiet(p) {
    return !!duong.chiTietDuAn && !!p.co_chi_tiet && p.xem_chi_tiet !== false;
  }

  function nutChiTiet(p) {
    if (!coChiTiet(p)) return '';
    var bat = !!chiTietBat[p.id];
    return '<button type="button" class="ht-mat ht-chi-tiet' + (bat ? ' dang-bat' : '') + '" data-chi-tiet-id="' + p.id + '"'
      + ' title="' + (bat ? 'Đang hiện chi tiết dự án — bấm để ẩn' : 'Hiện chi tiết dự án trên bản đồ') + '">' + SVG_LOP + '</button>';
  }

  function timDuAn(id) {
    for (var i = 0; i < duAn.length; i++) if (duAn[i].id === id) return duAn[i];
    return null;
  }

  function veChiTiet(p, nhom) {
    var fg = L.featureGroup();
    var demMau = 0;
    nhom.forEach(function (n) {
      if (!n.hien) return; // nhóm người nhập để ẩn sẵn (VD cáp ngầm chiếu sáng) chỉ bật ở trang dự án
      var mau = n.loai === 'diem' ? p.mau : (n.mau || BANG_MAU_CHI_TIET[demMau++ % BANG_MAU_CHI_TIET.length]);
      n.doi_tuong.forEach(function (d) {
        var toa = d.toa_do || [];
        if (!toa.length) return;
        var nhan = function (i) { return (d.nhan && d.nhan[i || 0]) || d.ten || n.ten; };
        if (n.loai === 'diem') {
          var nhieu = toa.length > 150;
          toa.forEach(function (c, i) {
            var m = nhieu
              ? L.circleMarker(c, { pane: 'chiTietDuAn', radius: 4, color: '#fff', weight: 1, fillColor: mau, fillOpacity: 0.95 })
              : L.marker(c, { icon: BieuTuongLoaiHinh.divIcon(n.bieu_tuong || 'diem_moc', mau, 22) });
            m.bindTooltip(thoatHtml(nhan(i)), { direction: 'top', className: 'nhan-ha-tang' }).addTo(fg);
          });
        } else if (n.loai === 'duong') {
          L.polyline(toa, { pane: 'chiTietDuAn', color: '#1b1f23', weight: 5.5, opacity: 0.45, interactive: false }).addTo(fg);
          L.polyline(toa, { pane: 'chiTietDuAn', color: mau, weight: 3 })
            .bindTooltip(thoatHtml(nhan()), { sticky: true, className: 'nhan-ha-tang' }).addTo(fg);
        } else {
          // Vùng tô màu theo loại đất thì nền đậm, viền mảnh — đọc như bản đồ quy hoạch sử dụng đất
          L.polygon(toa, n.mau
            ? { pane: 'chiTietDuAn', color: mau, weight: 1.2, fillColor: mau, fillOpacity: 0.38 }
            : { pane: 'chiTietDuAn', color: mau, weight: 2.5, fillColor: mau, fillOpacity: 0.16 })
            .bindTooltip(thoatHtml(nhan()), { sticky: true, className: 'nhan-ha-tang' }).addTo(fg);
        }
      });
    });
    fg.bindPopup(function () { return bongChuThich(p); });
    return fg;
  }

  function taiChiTiet(id) {
    if (chiTietDaTai[id]) return Promise.resolve(chiTietDaTai[id]);
    if (!chiTietDangTai[id]) {
      chiTietDangTai[id] = fetch(duong.chiTietDuAn.replace('__ID__', id), { headers: { Accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function (j) {
          chiTietDaTai[id] = veChiTiet(timDuAn(id) || { id: id, ten: j.ten, mau: '#5b6770' }, j.nhom || []);
          return chiTietDaTai[id];
        })
        .finally(function () { delete chiTietDangTai[id]; });
    }
    return chiTietDangTai[id];
  }

  // Đưa chi tiết 1 dự án lên/xuống bản đồ theo trạng thái hiện tại: đang bật, có trong kết quả lọc và
  // không bị ẩn bằng nút mắt. phong: phóng tới dự án (khi người xem vừa bấm bật).
  function apChiTiet(id, phong) {
    var p = timDuAn(id);
    if (!chiTietBat[id] || !p || !coChiTiet(p) || anDuAn[id]) {
      if (chiTietDaTai[id]) lopChiTiet.removeLayer(chiTietDaTai[id]);
      return;
    }
    taiChiTiet(id).then(function (fg) {
      if (!chiTietBat[id] || anDuAn[id] || !timDuAn(id)) return; // đã tắt trong lúc chờ tải
      lopChiTiet.addLayer(fg);
      if (phong && fg.getBounds().isValid()) map.fitBounds(fg.getBounds(), { padding: [40, 40], maxZoom: 16 });
    }).catch(function () { canhBao('Không tải được chi tiết dự án.'); });
  }

  function batTatChiTiet(id) {
    if (chiTietBat[id]) delete chiTietBat[id]; else chiTietBat[id] = true;
    ghiNho('chiTiet', dsKhoaBat(chiTietBat).map(Number));
    apChiTiet(id, !!chiTietBat[id]);
    veDanhSach();
    if (popupMo) popupMo.update();
  }

  // Sau mỗi lần tải lại danh sách (lọc, tìm): gỡ chi tiết của dự án không còn trong kết quả, đưa lại
  // chi tiết các dự án đang bật
  function dongBoChiTiet() {
    Object.keys(chiTietDaTai).forEach(function (id) {
      if (!chiTietBat[id] || !timDuAn(Number(id))) lopChiTiet.removeLayer(chiTietDaTai[id]);
    });
    Object.keys(chiTietBat).forEach(function (id) { apChiTiet(Number(id), false); });
  }

  var popupMo = null;
  map.on('popupopen', function (e) { popupMo = e.popup; });
  map.on('popupclose', function (e) { if (popupMo === e.popup) popupMo = null; });
  map.getContainer().addEventListener('click', function (e) {
    var a = e.target.closest ? e.target.closest('[data-chi-tiet-popup]') : null;
    if (!a) return;
    e.preventDefault();
    batTatChiTiet(Number(a.getAttribute('data-chi-tiet-popup')));
  });

  // Gom lop_id cua tung muc con trong 1 nhom thanh 1 mang duy nhat, de gan cho nut an/hien
  // dung o cap cha — bam 1 lan la doi trang thai toan bo cac lop con ben trong.
  function gomLopId(ds) {
    var ra = [];
    (ds || []).forEach(function (t) { if (t.lop_id) ra = ra.concat(t.lop_id); });
    return ra;
  }

  // Trang thai "dang hien" dai dien cho ca nhom: chi coi la dang hien khi TOAN BO muc con
  // (co du lieu) dang hien — dung de quyet dinh icon con mat nao hien thi ban dau.
  function tatCaDangHien(ds) {
    return !!(ds && ds.length) && ds.every(function (t) { return t.hien_thi; });
  }

  function veNhomTuyen(ds, nhan, khoa) {
    if (!ds || !ds.length) return '';
    var muc = ds.map(function (t) {
      return '<div class="htmuc" data-gioi-han=\'' + JSON.stringify(t.gioi_han || null) + '\'>'
        + '<span>' + thoatHtml(t.ten) + '</span>'
        + '<span class="htmuc-phai">' + nutMat(t.hien_thi, t.lop_id) + '<span class="htmuc-dem">' + t.so_doi_tuong + ' đối tượng</span></span></div>';
    }).join('');
    return '<div class="htnhom" data-khoa="' + thoatHtml(khoa) + '"><div class="htnhom-hd"><span class="mui">▶</span>' + nhan + ' (' + ds.length + ')'
      + nutMat(tatCaDangHien(ds), gomLopId(ds)) + '</div>'
      + '<div class="htnhom-body">' + muc + '</div></div>';
  }

  function veNhomTba(nhom, nhan, khoa, donVi) {
    var ds = (nhom && nhom.ds) || [];
    if (!ds.length) return '';
    var muc = ds.map(function (t) {
      return '<div class="htmuc" data-vi-do="' + (t.vi_do == null ? '' : t.vi_do) + '" data-kinh-do="' + (t.kinh_do == null ? '' : t.kinh_do) + '">'
        + '<span>' + thoatHtml(t.ten) + '</span></div>';
    }).join('');
    // Tổng công suất chỉ hiện khi có ít nhất 1 trạm ghi công suất trong tên (đa số nhóm Quy hoạch
    // chưa có thông tin này nên bỏ qua, tránh hiện "0 MVA" gây hiểu nhầm là các trạm không có công suất).
    var demNhan = ds.length + ' ' + (donVi || 'trạm') + (nhom.tong_mva ? ', ' + nhom.tong_mva + ' MVA' : '');
    // Ẩn/hiện chỉ áp dụng được cho cả nhóm (TBA của cùng 1 lớp), không tách riêng từng trạm được.
    return '<div class="htnhom" data-khoa="' + thoatHtml(khoa) + '"><div class="htnhom-hd"><span class="mui">▶</span>' + nhan + ' (' + demNhan + ')'
      + nutMat(nhom.hien_thi, nhom.lop_id) + '</div>'
      + '<div class="htnhom-body">' + muc + '</div></div>';
  }

  // Gộp lop_id và trạng thái "đang hiện" của nhiều nhóm (mỗi nhóm có lop_id, hien_thi, có thể có ds) — dùng
  // cho nút con mắt chung ở đầu nhánh / đầu phần: bấm 1 lần là đổi trạng thái mọi lớp bên trong.
  function gomNhom(dsNhom) {
    var id = [], hien = true, co = false;
    dsNhom.forEach(function (n) {
      if (!n || !n.lop_id || !n.lop_id.length || (n.ds && !n.ds.length)) return;
      id = id.concat(n.lop_id);
      hien = hien && !!n.hien_thi;
      co = true;
    });
    return { id: id, hien: co && hien };
  }

  // Đường dây đấu nối nguồn điện: liệt kê từng tuyến (mỗi tuyến ứng với 1 nhà máy hoặc 1 cụm nhà máy),
  // bấm vào là bay tới tuyến; ẩn/hiện theo cả nhóm vì dữ liệu lưu theo lớp.
  function veNhomDauNoi(nhom, nhan, khoa) {
    var ds = (nhom && nhom.ds) || [];
    if (!ds.length) return '';
    var muc = ds.map(function (t) {
      return '<div class="htmuc" data-gioi-han=\'' + JSON.stringify(t.gioi_han || null) + '\'>'
        + '<span>' + thoatHtml(t.ten) + (t.phu ? '<small class="htmuc-phu">' + thoatHtml(t.phu) + '</small>' : '') + '</span></div>';
    }).join('');
    return '<div class="htnhom" data-khoa="' + thoatHtml(khoa) + '"><div class="htnhom-hd"><span class="mui">▶</span>' + nhan + ' (' + ds.length + ' tuyến)'
      + nutMat(nhom.hien_thi, nhom.lop_id) + '</div>'
      + '<div class="htnhom-body">' + muc + '</div></div>';
  }

  // 1 nhánh (Hiện trạng hoặc Quy hoạch): phần lưới truyền tải - phân phối (đường dây, TBA theo cấp điện áp)
  // và phần đấu nối nguồn điện (đường dây đấu nối, trạm nâng áp/trạm cắt nhà máy, nguồn điện theo CSDL).
  function veNhanhLuoi(nh, ma, nhan) {
    var dn = nh.dau_noi, tuyenLuoi = [], soTuyen = 0, soTba = 0, soDauNoi = 0;
    nh.duong_day.forEach(function (c) { tuyenLuoi = tuyenLuoi.concat(c.ds); soTuyen += c.ds.length; });
    nh.tba.forEach(function (c) { soTba += c.ds.length; });
    dn.duong_day.forEach(function (c) { soDauNoi += c.ds.length; });

    var luoi = nh.duong_day.map(function (c) { return veNhomTuyen(c.ds, 'Đường dây ' + c.kv + 'kV', ma + '|dd|' + c.kv); }).join('')
      + nh.tba.map(function (c) { return veNhomTba(c, 'Trạm biến áp ' + c.kv + 'kV', ma + '|tba|' + c.kv); }).join('');
    var dauNoi = dn.duong_day.map(function (c) { return veNhomDauNoi(c, 'Đường dây đấu nối ' + c.kv + 'kV', ma + '|dn|' + c.kv); }).join('')
      + veNhomTba(dn.tram, 'Trạm nâng áp, trạm cắt nhà máy điện', ma + '|dn-tram')
      + veNhomTba(dn.nha_may, 'Nguồn điện theo CSDL Quy hoạch tỉnh, chưa có trong danh sách dự án', ma + '|dn-nm', 'nhà máy');

    var gLuoi = gomNhom(tuyenLuoi.concat(nh.tba));
    var gDauNoi = gomNhom(dn.duong_day.concat([dn.tram, dn.nha_may]));
    var gTatCa = gomNhom([{ lop_id: gLuoi.id, hien_thi: gLuoi.hien }, { lop_id: gDauNoi.id, hien_thi: gDauNoi.hien }]);
    var dem = [soTuyen ? soTuyen + ' tuyến' : '', soTba ? soTba + ' TBA' : '', soDauNoi ? soDauNoi + ' tuyến đấu nối' : ''].filter(Boolean).join(' · ');

    return '<div class="httier ht-nhanh" data-khoa="' + ma + '"><div class="httier-hd"><span class="mui">▶</span><span>' + nhan + '</span>'
      + (dem ? '<span class="httier-dem">' + dem + '</span>' : '') + nutMat(gTatCa.hien, gTatCa.id) + '</div>'
      + '<div class="httier-body">'
      + (luoi ? '<div class="ht-khoi"><div class="ht-phan"><span>Lưới truyền tải, phân phối</span>' + nutMat(gLuoi.hien, gLuoi.id) + '</div>' + luoi + '</div>' : '')
      + (dauNoi ? '<div class="ht-khoi ht-khoi-dn"><div class="ht-phan"><span>Đấu nối nguồn điện</span>' + nutMat(gDauNoi.hien, gDauNoi.id) + '</div>' + dauNoi + '</div>' : '')
      + (luoi || dauNoi ? '' : '<div class="ds-troi">Chưa có dữ liệu.</div>')
      + '</div></div>';
  }

  function veCayHaTang(ds) {
    var box = document.getElementById('dsHaTang');
    var dem = function (nh) {
      var t = 0, b = 0, d = 0;
      nh.duong_day.forEach(function (c) { t += c.ds.length; });
      nh.tba.forEach(function (c) { b += c.ds.length; });
      nh.dau_noi.duong_day.forEach(function (c) { d += c.ds.length; });
      return [t, b, d];
    };
    var a = dem(ds.hien_trang), q = dem(ds.quy_hoach);
    document.getElementById('demHaTang').textContent = (a[0] + q[0]) + ' tuyến lưới, ' + (a[1] + q[1]) + ' TBA, '
      + (a[2] + q[2]) + ' tuyến đấu nối nguồn điện';

    // Lần đầu mở menu thì mở sẵn cả 2 nhánh; các lần vẽ lại sau đó (sau khi ẩn/hiện lớp) giữ nguyên nhánh
    // đang mở/đóng — lamMoiCayHaTang() tự mở lại đúng các nhánh, nhóm người dùng đang mở.
    var lanDau = !box.dataset.daVe;
    box.innerHTML = veNhanhLuoi(ds.hien_trang, 'ht', 'Lưới điện hiện trạng') + veNhanhLuoi(ds.quy_hoach, 'qh', 'Lưới điện quy hoạch');
    box.dataset.daVe = '1';
    if (lanDau) Array.prototype.forEach.call(box.querySelectorAll('.httier'), function (el) { el.classList.add('mo'); });

    Array.prototype.forEach.call(box.querySelectorAll('.httier-hd'), function (el) {
      el.addEventListener('click', function (e) {
        if (e.target.closest('.ht-mat')) return;
        el.parentElement.classList.toggle('mo');
      });
    });
    Array.prototype.forEach.call(box.querySelectorAll('.htnhom-hd'), function (el) {
      el.addEventListener('click', function (e) {
        if (e.target.closest('.ht-mat')) return;
        el.parentElement.classList.toggle('mo');
      });
    });
    Array.prototype.forEach.call(box.querySelectorAll('.ht-mat'), function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (btn.disabled) return;
        var dsLopId = JSON.parse(btn.dataset.lopId);
        // Trang thai DICH cu the, khong phai dao nguoc — 1 nut co the dai dien nhieu lop dang o
        // cac trang thai khac nhau (VD 1 nhom co lop dang hien, lop dang an); neu de moi lop tu
        // dao nguoc rieng thi sau khi bam van lech nhau. Ep TAT CA ve CUNG 1 trang thai dich.
        var muonHien = btn.classList.contains('dang-an');
        btn.disabled = true;
        // Gửi 1 yêu cầu cho cả nhóm lớp: hosting giới hạn số kết nối đồng thời, gửi mỗi lớp 1 yêu cầu (hàng
        // chục yêu cầu cùng lúc khi bấm nút cả nhánh) thì một số bị từ chối và nút báo lỗi.
        var guiYeuCau = duong.anHienNhieuLop
          ? fetch(duong.anHienNhieuLop, {
              method: 'PATCH',
              headers: { 'X-CSRF-TOKEN': CSRF, Accept: 'application/json', 'Content-Type': 'application/json' },
              body: JSON.stringify({ lop_id: dsLopId, hien_thi: muonHien })
            }).then(function (r) { return [r]; })
          : Promise.all(dsLopId.map(function (id) {
              return fetch(duong.anHienLop.replace('__ID__', id) + '?hien_thi=' + (muonHien ? '1' : '0'), {
                method: 'PATCH',
                headers: { 'X-CSRF-TOKEN': CSRF, Accept: 'application/json' }
              });
            }));
        guiYeuCau.then(function (ds2) {
          if (ds2.some(function (r) { return !r.ok; })) throw new Error('loi');
          // Tai lai toan bo cay tu server thay vi chi sua rieng nut vua bam — vi 1 nut co the
          // dai dien cho ca nhom/ca nhanh, bam no lam thay doi trang thai cua nhieu nut con khac.
          // lamMoiCayHaTang() tu giu lai nhanh nao dang mo truoc do.
          lamMoiCayHaTang();
          taiHaTang();
        }).catch(function () {
          btn.disabled = false;
          canhBao('Không đổi được trạng thái hiện/ẩn lớp.');
        });
      });
    });
    Array.prototype.forEach.call(box.querySelectorAll('.htmuc'), function (el) {
      el.addEventListener('click', function (e) {
        if (e.target.closest('.ht-mat')) return;
        var gh = el.dataset.gioiHan;
        if (gh && gh !== 'null') {
          map.fitBounds(JSON.parse(gh), { padding: [30, 30] });
        } else if (el.dataset.viDo && el.dataset.kinhDo) {
          map.setView([parseFloat(el.dataset.viDo), parseFloat(el.dataset.kinhDo)], Math.max(map.getZoom(), 15));
        }
      });
    });
  }

  var tuKhoaHaTangEl = document.getElementById('tuKhoaHaTang');
  if (tuKhoaHaTangEl) {
    tuKhoaHaTangEl.addEventListener('input', function () {
      var tu = this.value.trim().toLowerCase();
      var box = document.getElementById('dsHaTang');
      Array.prototype.forEach.call(box.querySelectorAll('.httier'), function (tier) {
        var coKhopTier = false;
        Array.prototype.forEach.call(tier.querySelectorAll('.ht-khoi'), function (khoi) {
          var coKhopKhoi = false;
          Array.prototype.forEach.call(khoi.querySelectorAll('.htnhom'), function (nhom) {
            var coKhopNhom = false;
            Array.prototype.forEach.call(nhom.querySelectorAll('.htmuc'), function (muc) {
              var khop = !tu || muc.textContent.toLowerCase().indexOf(tu) !== -1;
              muc.style.display = khop ? '' : 'none';
              if (khop) coKhopNhom = true;
            });
            nhom.style.display = coKhopNhom ? '' : 'none';
            nhom.classList.toggle('mo', coKhopNhom && !!tu);
            if (coKhopNhom) coKhopKhoi = true;
          });
          khoi.style.display = coKhopKhoi ? '' : 'none';
          if (coKhopKhoi) coKhopTier = true;
        });
        tier.style.display = coKhopTier ? '' : 'none';
        if (tu && coKhopTier) tier.classList.add('mo');
      });
    });
  }

  /* ---------- chuyển tab "Dự án" / "Lưới điện" trong khung bên ---------- */
  var tabNuts = document.querySelectorAll('.aside-tab-nut');
  var hdHaTangEl = document.getElementById('hdHaTang');
  var dsHaTangEl = document.getElementById('dsHaTang');

  function chonTab(tab) {
    Array.prototype.forEach.call(tabNuts, function (n) { n.classList.toggle('chon', n.dataset.tab === tab); });
    var laDuAn = tab !== 'haTang';
    document.getElementById('hdDuAn').style.display = laDuAn ? '' : 'none';
    document.getElementById('danhSach').style.display = laDuAn ? '' : 'none';
    if (hdHaTangEl) hdHaTangEl.style.display = laDuAn ? 'none' : '';
    if (dsHaTangEl) dsHaTangEl.style.display = laDuAn ? 'none' : '';
    if (!laDuAn) taiThongKeHaTang();
  }
  Array.prototype.forEach.call(tabNuts, function (n) {
    n.addEventListener('click', function () {
      chonTab(n.dataset.tab);
      ghiNho('tab', n.dataset.tab);
    });
  });
  // Tab "Lưới điện" chỉ có với tài khoản không phải chủ đầu tư
  if (daNho.tab === 'haTang' && document.querySelector('.aside-tab-nut[data-tab="haTang"]')) chonTab('haTang');

  /* ---------- sự kiện ---------- */
  function hoan(fn, ms) {
    clearTimeout(hen);
    hen = setTimeout(fn, ms);
  }

  document.getElementById('tuKhoa').addEventListener('input', function () { hoan(taiDuAn, 350); });
  document.getElementById('locLoaiHinh').addEventListener('change', taiDuAn);
  document.getElementById('locTrangThai').addEventListener('change', taiDuAn);
  map.on('moveend zoomend', function () { hoan(taiHaTang, 300); });

  var locNenEl = document.getElementById('locNen');
  if (locNenEl) locNenEl.addEventListener('change', function () { chonLopNen(this.value); });

  var locKvChangeEl = document.getElementById('locKv');
  if (locKvChangeEl) locKvChangeEl.addEventListener('change', taiHaTang);

  var locHienTenDuAnEl = document.getElementById('locHienTenDuAn');
  if (locHienTenDuAnEl) {
    var apDungTenDuAn = function () {
      if (locHienTenDuAnEl.checked) {
        map.addLayer(lopTenDuAn);
        tranhChongNhan();
      } else {
        map.removeLayer(lopTenDuAn);
        anNhanLuoiTrung([]);
      }
    };
    locHienTenDuAnEl.addEventListener('change', apDungTenDuAn);
    // Áp ngay trạng thái đã ghi nhớ (hoặc trình duyệt tự giữ lại khi quay lại trang)
    apDungTenDuAn();
  }

  var locAnDiemEl = document.getElementById('locAnDiem');
  if (locAnDiemEl) locAnDiemEl.addEventListener('change', taiHaTang);

  var locHienTenDiemEl = document.getElementById('locHienTenDiem');
  if (locHienTenDiemEl) locHienTenDiemEl.addEventListener('change', taiHaTang);

  var locDoDayDuongEl = document.getElementById('locDoDayDuong');
  if (locDoDayDuongEl) locDoDayDuongEl.addEventListener('change', taiHaTang);

  // "Sửa vị trí" luôn tắt khi mở lại trang (không nhớ như các tuỳ chọn hiển thị khác) — tránh bật
  // nhầm sẵn ở phiên sau rồi vô tình kéo lệch điểm khi chỉ định lướt xem bản đồ.
  var locSuaViTriEl = document.getElementById('locSuaViTri');
  if (locSuaViTriEl) locSuaViTriEl.addEventListener('change', function () {
    // Tắt chế độ sửa khi đang sửa dở 1 tuyến: hỏi trước nếu còn thay đổi chưa lưu
    if (!locSuaViTriEl.checked && suaTuyen && !huySuaTuyen()) { locSuaViTriEl.checked = true; return; }
    taiHaTang();
  });

  /* ---------- thu gọn / mở khung danh sách (nút "Mục lục" gộp chung 2 nút Danh sách/Lưới điện cũ) ---------- */
  var aside = document.getElementById('asideBanDo');
  var moKhungBen = document.getElementById('moKhungBen');

  document.getElementById('dongAside').addEventListener('click', function () {
    aside.classList.add('thu-gon');
    moKhungBen.classList.add('hien');
    ghiNho('moMucLuc', false);
    setTimeout(function () { map.invalidateSize(); }, 200);
  });
  moKhungBen.addEventListener('click', function () {
    aside.classList.remove('thu-gon');
    moKhungBen.classList.remove('hien');
    ghiNho('moMucLuc', true);
    setTimeout(function () { map.invalidateSize(); }, 200);
  });

  var legend = document.getElementById('legendBanDo');
  var moLegend = document.getElementById('moLegend');
  document.getElementById('dongLegend').addEventListener('click', function () {
    legend.classList.add('thu-gon');
    moLegend.classList.add('hien');
    ghiNho('moChuGiai', false);
  });
  moLegend.addEventListener('click', function () {
    legend.classList.remove('thu-gon');
    moLegend.classList.remove('hien');
    ghiNho('moChuGiai', true);
  });

  /* chú giải loại hình dùng chung huy hiệu với điểm trên bản đồ */
  Array.prototype.forEach.call(document.querySelectorAll('#chuGiaiLoaiHinh .chugiai-hang'), function (el) {
    var o = el.querySelector('.chugiai-icon');
    if (o) o.outerHTML = BieuTuongLoaiHinh.badgeHtml(el.dataset.bieuTuong, el.dataset.mau, 18);
  });

  taiDuAn();
  taiHaTang();
})();
