<script>
(function () {
  // Ô ở đầu cột: chọn/bỏ chọn cả cột; tự đánh dấu khi cả cột đang được chọn
  Array.prototype.forEach.call(document.querySelectorAll('[data-chon-het]'), function (tong) {
    var loai = tong.dataset.chonHet;
    var ds = Array.prototype.slice.call(document.querySelectorAll('[data-loai="' + loai + '"]'));
    function capNhat() {
      var chon = ds.filter(function (o) { return o.checked; }).length;
      tong.checked = ds.length > 0 && chon === ds.length;
      tong.indeterminate = chon > 0 && chon < ds.length;
    }
    tong.addEventListener('change', function () { ds.forEach(function (o) { o.checked = tong.checked; }); });
    ds.forEach(function (o) { o.addEventListener('change', capNhat); });
    capNhat();
  });
})();
</script>
