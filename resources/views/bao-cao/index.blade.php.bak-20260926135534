  @push('cuoi_trang')
  <script>
  (function () {
    var chon = document.getElementById('baoCaoDuAn');
    var tienDo = document.getElementById('baoCaoTienDo');
    var mocCot = @json(array_keys(\App\Models\DuAn::HO_SO_PHAP_LY));

    chon.addEventListener('change', function () {
      var o = chon.options[chon.selectedIndex];
      tienDo.value = o.dataset.tienDo || 0;
      mocCot.forEach(function (cot) {
        var el = document.getElementById('baoCao-' + cot);
        if (el) el.checked = o.dataset[cot.replace(/_([a-z])/g, function (m, c) { return c.toUpperCase(); })] === '1';
      });
    });
  })();
  </script>
