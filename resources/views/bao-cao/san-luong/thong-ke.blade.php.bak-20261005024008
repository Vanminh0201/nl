<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js"></script>
<script>
(function () {
  if (typeof Chart === 'undefined') return;
  Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
  Chart.defaults.color = '#4a5866';
  var bd = @json($bieuDo);
  var thang = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'];
  var so = function (v) { return v === null || v === undefined ? '—' : v.toLocaleString('vi-VN', { maximumFractionDigits: 2 }); };
  var truc = { beginAtZero: true, grid: { color: '#e2e6e1' }, ticks: { callback: function (v) { return v.toLocaleString('vi-VN'); } } };
  var goiY = { callbacks: { label: function (c) { return (c.dataset.label ? c.dataset.label + ': ' : '') + so(c.parsed.y !== undefined && c.chart.options.indexAxis !== 'y' ? c.parsed.y : c.parsed.x) + ' triệu kWh'; } } };
  function ve(id, cauHinh) { var el = document.getElementById(id); if (el) new Chart(el, cauHinh); }
  var chung = { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false } };

  ve('bdThang', { type: 'bar', data: { labels: thang, datasets: [
    { label: '{{ $nam }}', data: bd.thang.nay, backgroundColor: '#1f4b6e', borderRadius: 3, maxBarThickness: 26 },
    { label: '{{ $namTruoc }}', data: bd.thang.truoc, backgroundColor: '#b7c6d2', borderRadius: 3, maxBarThickness: 26 }
  ] }, options: Object.assign({}, chung, { plugins: { tooltip: goiY, legend: { labels: { boxWidth: 12 } } }, scales: { y: truc, x: { grid: { display: false } } } }) });

  ve('bdLuyKe', { type: 'line', data: { labels: thang, datasets: [
    { label: '{{ $nam }}', data: bd.luy_ke.nay, borderColor: '#1f4b6e', backgroundColor: 'rgba(31,75,110,.12)', fill: true, tension: .25, pointRadius: 3 },
    { label: '{{ $namTruoc }}', data: bd.luy_ke.truoc, borderColor: '#96a8b6', borderDash: [5, 4], tension: .25, pointRadius: 2 }
  ] }, options: Object.assign({}, chung, { plugins: { tooltip: goiY, legend: { labels: { boxWidth: 12 } } }, scales: { y: truc, x: { grid: { display: false } } } }) });

  ve('bdLoaiHinh', { type: 'bar', data: { labels: thang, datasets: bd.loai_hinh.map(function (l) {
    return { label: l.nhan, data: l.so, backgroundColor: l.mau, borderRadius: 2, maxBarThickness: 30 };
  }) }, options: Object.assign({}, chung, { plugins: { tooltip: goiY, legend: { labels: { boxWidth: 12 } } }, scales: { x: { stacked: true, grid: { display: false } }, y: Object.assign({ stacked: true }, truc) } }) });

  ve('bdTop', { type: 'bar', data: { labels: bd.top.map(function (r) { return r.nhan; }), datasets: [
    { data: bd.top.map(function (r) { return r.so; }), backgroundColor: bd.top.map(function (r) { return r.mau; }), borderRadius: 3, maxBarThickness: 20 }
  ] }, options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: goiY }, scales: { x: truc, y: { grid: { display: false } } } } });

  var bangMau = ['#1f4b6e', '#c2185b', '#2f6b4f', '#b4531c', '#7a60fb', '#96701a', '#1d6f86', '#5d6b61'];
  ve('bdChiTiet', { type: 'line', data: { labels: thang, datasets: (bd.chi_tiet || []).map(function (n, i) {
    return { label: String(n.nam), data: n.so, borderColor: bangMau[i % bangMau.length], backgroundColor: bangMau[i % bangMau.length], tension: .25, pointRadius: 3, borderWidth: i === 0 ? 3 : 2 };
  }) }, options: Object.assign({}, chung, { plugins: { tooltip: goiY, legend: { labels: { boxWidth: 12 } } }, scales: { y: truc, x: { grid: { display: false } } } }) });
})();
</script>
