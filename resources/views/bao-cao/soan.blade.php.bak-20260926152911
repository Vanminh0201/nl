<script>
(function () {
  var form = document.getElementById('formBaoCao');
  var daSua = false;

  form.addEventListener('input', function () { daSua = true; });
  form.addEventListener('change', function () { daSua = true; });
  form.addEventListener('submit', function (e) {
    if (e.submitter && e.submitter.hasAttribute('data-nop')
        && !confirm('Nộp báo cáo {{ $ky->ten() }} cho Sở Công Thương?')) {
      e.preventDefault();
      return;
    }
    daSua = false;
  });
  window.addEventListener('beforeunload', function (e) {
    if (daSua) { e.preventDefault(); e.returnValue = ''; }
  });

  Array.prototype.forEach.call(document.querySelectorAll('[data-muc]'), function (muc) {
    var chon = muc.querySelector('[data-chon-muc]');
    chon.addEventListener('change', function () { muc.classList.toggle('tat', !chon.checked); });

    var khung = muc.querySelector('[data-giai-ngan]');
    var tiLe = khung.querySelector('[data-ti-le]');
    function so(cot) {
      var v = parseFloat(khung.querySelector('[data-so="' + cot + '"]').value);
      return isNaN(v) ? null : v;
    }
    function phanTram(a, b) {
      return (a / b * 100).toLocaleString('vi-VN', { maximumFractionDigits: 2 }) + '%';
    }
    function tinh() {
      var dong = [];
      var gn = so('giai_ngan_nam'), kh = so('ke_hoach_von_nam'), lk = so('luy_ke_giai_ngan'), tm = so('tong_muc_dau_tu');
      if (gn !== null && kh) dong.push('Giải ngân năm đạt ' + phanTram(gn, kh) + ' kế hoạch');
      if (lk !== null && tm) dong.push('lũy kế đạt ' + phanTram(lk, tm) + ' tổng mức đầu tư');
      tiLe.textContent = dong.length ? dong.join('; ') + '.' : '';
    }
    khung.addEventListener('input', tinh);
    tinh();
  });
})();
</script>
