<script>
(function () {
  Array.prototype.forEach.call(document.querySelectorAll('.chon-bieu-tuong'), function (el) {
    BieuTuongLoaiHinh.khoiTaoBoChon(el, 'bieu_tuong');
  });
  Array.prototype.forEach.call(document.querySelectorAll('.chon-hinh'), function (el) {
    BieuTuongLoaiHinh.khoiTaoBoChon(el, 'hinh');
  });
  Array.prototype.forEach.call(document.querySelectorAll('.xem-bieu-tuong-thuc'), function (el) {
    el.innerHTML = BieuTuongLoaiHinh.badgeHtml(el.dataset.ma, '#5b6773', 44);
  });

  // xem truoc ngay khi chon file moi, truoc khi luu — dung URL tam thoi cua trinh duyet
  Array.prototype.forEach.call(document.querySelectorAll('input[name="tep"]'), function (inp) {
    inp.addEventListener('change', function () {
      var form = inp.closest('form');
      var xem = form ? form.querySelector('.xem-bieu-tuong-thuc') : null;
      if (!inp.files[0] || !xem) return;
      var url = URL.createObjectURL(inp.files[0]);
      xem.innerHTML = '<span class="bieu-tuong-badge" style="width:44px;height:44px;background:#5b6773">'
        + '<span class="bieu-tuong-anh" style="width:26px;height:26px;-webkit-mask-image:url(\'' + url + '\');mask-image:url(\'' + url + '\')"></span></span>';
    });
  });
})();
</script>
