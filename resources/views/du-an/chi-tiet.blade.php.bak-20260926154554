<script src="{{ asset('js/bieu-tuong.js') }}?v={{ filemtime(public_path('js/bieu-tuong.js')) }}"></script>
<script>
(function () {
  var cfg = @json(config('duan.ban_do'));
  var lat = {{ $duAn->vi_do }}, lng = {{ $duAn->kinh_do }};
  var map = L.map('mapChiTiet').setView([lat, lng], 13);
  L.tileLayer(cfg.tile, { maxZoom: 18, attribution: cfg.ghi_nguon }).addTo(map);
  var mau = @json($duAn->mau);
  var coHinhDang = @json($duAn->co_hinh_dang);
  var gioiHan = null;

  function monRong(b) { gioiHan = gioiHan ? gioiHan.extend(b) : b; }

  function thoatHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  if (!coHinhDang) {
    var diem = L.marker([lat, lng], { icon: BieuTuongLoaiHinh.divIcon(@json($duAn->bieu_tuong_loai_hinh), mau, 32) })
      .addTo(map).bindTooltip(thoatHtml(@json($duAn->ten)));
    monRong(diem.getLatLng().toBounds(10));
  }

  @foreach ($duAn->hinhHoc->where('hien_thi', true) as $h)
    (function () {
      var toa = @json($h->toa_do);
      @if ($h->loai === 'diem')
        var nhanDiem = @json($h->nhan_diem);
        var lop = L.featureGroup();
        toa.forEach(function (p, i) {
          var m = L.marker(p, { icon: BieuTuongLoaiHinh.divIcon(@json($h->bieu_tuong ?? 'diem_moc'), mau, 26) });
          var nhan = (nhanDiem && nhanDiem[i]) || @json($h->ten);
          if (nhan) m.bindTooltip(thoatHtml(nhan));
          m.addTo(lop);
        });
      @else
        var lop = {!! $h->loai === 'duong'
          ? "L.polyline(toa, { color: mau, weight: 3 })"
          : "L.polygon(toa, { color: mau, weight: 2, fillOpacity: 0.18 })" !!};
        @if ($h->ten)
          lop.bindTooltip(thoatHtml(@json($h->ten)));
        @endif
      @endif
      lop.addTo(map);
      monRong(lop.getBounds ? lop.getBounds() : lop.getLatLng().toBounds(10));
    })();
  @endforeach

  // Chặn zoom quá sâu (maxZoom riêng cho fitBounds, khác maxZoom của lớp nền) khi dự án chỉ có
  // 1 điểm đại diện — bo tròn 10m quanh 1 điểm khiến fitBounds tự phóng lên hết cỡ (18), vượt quá
  // độ phân giải ảnh vệ tinh Esri thực có ở nhiều vùng nông thôn, hiện "Map data not available".
  if (gioiHan) map.fitBounds(gioiHan, { padding: [20, 20], maxZoom: 16 });
})();
</script>
