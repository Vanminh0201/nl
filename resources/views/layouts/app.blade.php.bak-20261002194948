<script>
(function () {
  // Dùng chung cho mọi nhãn ẩn/hiện kiểu này trên thanh đầu trang (Mục lục, Cài đặt...) —
  // mỗi khối ".muc-luc" tự có nút bấm + bảng riêng, không cần biết trước bao nhiêu khối.
  var khoi = Array.prototype.slice.call(document.querySelectorAll('.muc-luc'));
  khoi.forEach(function (k) {
    var nut = k.querySelector('.muc-luc-nut');
    var bang = k.querySelector('.muc-luc-bang');
    if (!nut || !bang) return;
    nut.addEventListener('click', function () {
      var dangMo = !bang.hidden;
      // Đóng các bảng khác đang mở trước khi mở bảng này, tránh chồng nhiều bảng cùng lúc.
      khoi.forEach(function (k2) {
        if (k2 !== k) {
          var b2 = k2.querySelector('.muc-luc-bang'), n2 = k2.querySelector('.muc-luc-nut');
          if (b2) b2.hidden = true;
          if (n2) n2.setAttribute('aria-expanded', 'false');
        }
      });
      bang.hidden = dangMo;
      nut.setAttribute('aria-expanded', String(!dangMo));
    });
  });
  // Menu chính trên màn hình hẹp: nút ☰ mở/đóng danh sách mục; bấm ra ngoài hoặc phím Esc thì đóng
  var navMo = document.getElementById('navMo'), nav = document.getElementById('navChinh');
  function datNav(mo) {
    nav.classList.toggle('mo', mo);
    navMo.setAttribute('aria-expanded', String(mo));
  }
  navMo.addEventListener('click', function () {
    var mo = !nav.classList.contains('mo');
    if (mo) {
      khoi.forEach(function (k) {
        var b = k.querySelector('.muc-luc-bang'), n = k.querySelector('.muc-luc-nut');
        if (b) b.hidden = true;
        if (n) n.setAttribute('aria-expanded', 'false');
      });
    }
    datNav(mo);
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') datNav(false); });
  khoi.forEach(function (k) {
    var n = k.querySelector('.muc-luc-nut');
    if (n) n.addEventListener('click', function () { datNav(false); });
  });

  document.addEventListener('click', function (e) {
    if (nav.classList.contains('mo') && !e.target.closest('#navChinh') && !e.target.closest('#navMo')) datNav(false);
    khoi.forEach(function (k) {
      var bang = k.querySelector('.muc-luc-bang'), nut = k.querySelector('.muc-luc-nut');
      if (bang && !bang.hidden && !e.target.closest('.muc-luc')) {
        bang.hidden = true;
        if (nut) nut.setAttribute('aria-expanded', 'false');
      }
    });
  });
})();
</script>
