@php
  $thanh = function ($ds, $khoa, $donVi = '') {
    $max = collect($ds)->max($khoa) ?: 1;
    $ra = '';
    foreach ($ds as $r) {
      $mau = $r['mau'] ?? '#1f4b6e';
      $ra .= '<div class="brow" style="--c:'.$mau.'">'
        .'<div class="lbl"><i style="width:8px;height:8px;border-radius:50%;background:'.$mau.';display:inline-block;flex:0 0 8px"></i>'
        .'<span title="'.e($r['nhan']).'">'.e($r['nhan']).'</span></div>'
        .'<div class="val">'.number_format($r[$khoa], 0, ',', '.').$donVi.'</div>'
        .'<div class="track"><i style="width:'.round($r[$khoa] / $max * 100, 1).'%"></i></div>'
        .'</div>';
    }
    return $ra ?: '<p class="hint" style="margin:0">Chưa có dữ liệu.</p>';
  };
@endphp

